// Constants
var float PI = 3.141592653589793
var float RAD_TO_DEG = 180.0 / PI

// @function Computes Saturn's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
export get_helio_lon(float t) =>
    array<core.vsop_term> L0 = array.new<core.vsop_term>()
    array.push(L0, core.vsop_term.new(0.87401354029, 0.0, 0.0))
    array.push(L0, core.vsop_term.new(0.11107659780, 3.96205090159, 213.29909543800))
    array.push(L0, core.vsop_term.new(0.01414150957, 4.58581515873, 7.11354700080))
    array.push(L0, core.vsop_term.new(0.00398379386, 0.52112025957, 206.18554843720))
    array.push(L0, core.vsop_term.new(0.00350769223, 3.30329907896, 426.59819087600))
    array.push(L0, core.vsop_term.new(0.00206816296, 0.24658366938, 103.09277421860))
    array.push(L0, core.vsop_term.new(0.00079271288, 3.84007078530, 220.41264243880))
    array.push(L0, core.vsop_term.new(0.00023990355, 4.66976924553, 110.20632121940))
    array.push(L0, core.vsop_term.new(0.00016573588, 0.43719228296, 419.48464387520))
    array.push(L0, core.vsop_term.new(0.00014906995, 5.76903183869, 316.39186965660))

    array<core.vsop_term> L1 = array.new<core.vsop_term>()
    array.push(L1, core.vsop_term.new(213.54295595986, 0.0, 0.0))
    array.push(L1, core.vsop_term.new(0.01296855005, 1.82820544701, 213.29909543800))
    array.push(L1, core.vsop_term.new(0.00564347566, 2.88500136429, 7.11354700080))
    array.push(L1, core.vsop_term.new(0.00098323030, 1.08070061328, 426.59819087600))
    array.push(L1, core.vsop_term.new(0.00107678770, 2.27769911872, 206.18554843720))

    array<core.vsop_term> L2 = array.new<core.vsop_term>()
    array.push(L2, core.vsop_term.new(0.00116441181, 1.17987850633, 7.11354700080))
    array.push(L2, core.vsop_term.new(0.00091920844, 0.07425261094, 213.29909543800))
    array.push(L2, core.vsop_term.new(0.00090592251, 0.0, 0.0))

    L0sum = core.eval_vsop87(L0, t)
    L1sum = core.eval_vsop87(L1, t)
    L2sum = core.eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    core.mod360(lon_rad * RAD_TO_DEG)


// @function Computes Saturn's heliocentric ecliptic latitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic latitude in radians, range approximately [-0.05, +0.05]. Note: Returns radians, not degrees.
export get_helio_lat(float t) =>
    array<core.vsop_term> B0 = array.new<core.vsop_term>()
    array.push(B0, core.vsop_term.new(0.04330678040, 3.60284428399, 213.29909543800))
    array.push(B0, core.vsop_term.new(0.00240348303, 2.85238489390, 426.59819087600))
    array.push(B0, core.vsop_term.new(0.00084745939, 0.0, 0.0))
    array.push(B0, core.vsop_term.new(0.00030863357, 3.48441504465, 220.41264243880))
    array.push(B0, core.vsop_term.new(0.00034116063, 0.57297307844, 206.18554843720))
    core.eval_vsop87(B0, t)  // returns radians directly


// @function Computes Saturn's heliocentric radius (distance from Sun) using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric radius in astronomical units (AU). Typical range is 9.02-10.05 AU.
export get_helio_radius(float t) =>
    array<core.vsop_term> R0 = array.new<core.vsop_term>()
    array.push(R0, core.vsop_term.new(9.55758135486, 0.0, 0.0))
    array.push(R0, core.vsop_term.new(0.52921382865, 2.39226219733, 213.29909543800))
    array.push(R0, core.vsop_term.new(0.01873679934, 5.23549604660, 206.18554843720))
    array.push(R0, core.vsop_term.new(0.01464663959, 1.64763045468, 426.59819087600))
    array.push(R0, core.vsop_term.new(0.00821891141, 5.93520025371, 316.39186965660))

    array<core.vsop_term> R1 = array.new<core.vsop_term>()
    array.push(R1, core.vsop_term.new(0.06182981282, 0.25843511480, 213.29909543800))
    array.push(R1, core.vsop_term.new(0.00506577242, 0.71114650941, 206.18554843720))
    array.push(R1, core.vsop_term.new(0.00341394029, 5.79635741658, 426.59819087600))

    array<core.vsop_term> R2 = array.new<core.vsop_term>()
    array.push(R2, core.vsop_term.new(0.00436902572, 4.78671673044, 213.29909543800))
