// SHOWCASE PLOT - Uncomment for TradingView publication
// Demonstrates Moon geocentric data with 100-bar future projection
// Note: Moon uses Julian centuries and has no speed function
// ═══════════════════════════════════════════════════════════════════════════

var int LOOK_AHEAD = 250

// Polyline references (persist across bars)
var polyline lon_line = na
var polyline decl_line = na
var polyline node_line = na

T = core.get_julian_centuries(time)

// Historical data
lon = get_geo_ecl_lon(T)
decl = get_declination(T)
mean_node_lon = get_mean_north_node_lon(T)



plot(lon, "Moon Geocentric Longitude", color=color.silver)
plot(decl, "Moon Declination", color=color.red)
plot(mean_node_lon, "Lunar Node Longitude", color=color.lime)



// Future projection using polylines
if barstate.islast
    // Delete old polylines
    polyline.delete(lon_line)
    polyline.delete(decl_line)
    polyline.delete(node_line)

    // Build point arrays (start with current bar for smooth connection)
    array<chart.point> lon_pts = array.new<chart.point>()
    array<chart.point> decl_pts = array.new<chart.point>()
    array<chart.point> node_pts = array.new<chart.point>()

    // First point = current bar (connects polyline to historical plot)
    array.push(lon_pts, chart.point.from_time(time, lon))
    array.push(decl_pts, chart.point.from_time(time, decl))
    array.push(node_pts, chart.point.from_time(time, mean_node_lon))

    // Add future points
    for i = 1 to LOOK_AHEAD
        future_time = core.get_future_time(time, i)
        future_T = core.get_julian_centuries(future_time)

        f_lon = get_geo_ecl_lon(future_T)
        f_decl = get_declination(future_T)
        f_node = get_mean_north_node_lon(future_T)

        array.push(lon_pts, chart.point.from_time(future_time, f_lon))
        array.push(decl_pts, chart.point.from_time(future_time, f_decl))
        array.push(node_pts, chart.point.from_time(future_time, f_node))

    // Create polylines
    lon_line := polyline.new(lon_pts, xloc=xloc.bar_time,
                line_color=color.new(color.silver, 50), line_style=line.style_dotted, force_overlay=false)
    decl_line := polyline.new(decl_pts, xloc=xloc.bar_time,
                 line_color=color.new(color.red, 50), line_style=line.style_dotted, force_overlay=false)
    node_line := polyline.new(node_pts, xloc=xloc.bar_time,
                 line_color=color.new(color.lime, 50), line_style=line.style_dotted, force_overlay=false)
