//@version=6
library("blueprint_ephemeris_lib")

// Constants
var float PI = 3.141592653589793
var float RAD_TO_DEG = 180.0 / PI
var float DEG_TO_RAD = PI / 180.0
var float DAYS_PER_CENTURY = 36525.0

// ════════════════════ CORE UTILITIES ════════════════════

// need to pull these into other libs - for moon and pluto
get_julian_millennia(float time_) =>
    jd = time_ / 86400000.0 + 2440587.5
    (jd - 2451545.0) / 365250.0


// Use for the rest of the planets not moon or pluto 
get_julian_centuries(float time_) =>
    jd = time_ / 86400000.0 + 2440587.5
    (jd - 2451545.0) / 36525.0


// ─────────────────────── VSOP Term Type ───────────────────────
// A single VSOP term: amplitude * cos(phase + frequency * t)
type vsop_term
    float amp     // amplitude of the cosine term
    float phase   // phase offset in radians
    float freq    // frequency multiplier of t


// ─────────────────────── Evaluators ───────────────────────

// /**
//  * Evaluates a VSOP87 sum for a given array of vsop_terms
//  * @param terms terms - Array of vsop_term
//  * @param t - Julian centuries since J2000.0
//  * @return float - evaluated VSOP sum (in radians or AU)
//  */
eval_vsop87(array<vsop_term> terms, float t) =>
    sum = 0.0
    for i = 0 to array.size(terms) - 1
        t_i = array.get(terms, i)
        sum += t_i.amp * math.cos(t_i.phase + t_i.freq * t)
    sum

// /**
//  * Evaluates the time derivative of a VSOP87 sum (for velocity/speed)
//  * @param terms - Array of vsop_term
//  * @param t - Julian centuries since J2000.0
//  * @return float - time derivative of the VSOP sum
//  */
eval_vsop87_derivative(array<vsop_term> terms, float t) =>
    sum = 0.0
    for i = 0 to array.size(terms) - 1
        vsop_term term = array.get(terms, i)
        sum += -term.amp * term.freq * math.sin(term.phase + term.freq * t)
    sum


// ─────────────────────── Angle Utilities ───────────────────────

// /**
//  * Wraps any angle to [0, 360) degrees
//  * @param x - Angle in degrees
//  * @return float - Normalized angle
//  */
mod360(float x) => x - 360.0 * math.floor(x / 360.0)

// /**
//  * Custom atan2 implementation to handle full 360° domain
//  * @param y - y-coordinate
//  * @param x - x-coordinate
//  * @return float - angle in radians
//  */
custom_atan2(float y, float x) =>
    x > 0.0 ? math.atan(y / x) :
     x < 0.0 and y >= 0.0 ? math.atan(y / x) + PI :
     x < 0.0 and y < 0.0 ? math.atan(y / x) - PI :
     x == 0.0 and y > 0.0 ? PI / 2.0 :
     x == 0.0 and y < 0.0 ? -PI / 2.0 :
     0.0


// ─────────────────────── Earth Functions ───────────────────────

// /**
//  * Computes Earth's heliocentric radius (AU)
//  * Add more terms if planetary library fidelity is increased
//  */
get_earth_helio_radius(float t) =>
    array<vsop_term> R0 = array.new<vsop_term>()
    array.push(R0, vsop_term.new(1.00000101778, 0.0, 0.0))
    array.push(R0, vsop_term.new(0.01670861753, 3.09846350771, 6283.07584999140))
    array.push(R0, vsop_term.new(0.00013956023, 3.05524609620, 12566.15169998280))
    array.push(R0, vsop_term.new(0.00003083720, 5.19846674381, 77713.77146812050))
    array.push(R0, vsop_term.new(0.00001628461, 1.17387749012, 5753.38488489680))
    // New R0 terms
    array.push(R0, vsop_term.new(0.00001575572, 2.84685214877, 7860.41939243920))
    array.push(R0, vsop_term.new(0.00000924799, 5.45292236722, 11506.76976979360))
    array.push(R0, vsop_term.new(0.00000542439, 4.56409149777, 3930.20969621960))
    array.push(R0, vsop_term.new(0.00000472110, 3.66100022149, 5884.92684658320))
    array.push(R0, vsop_term.new(0.00000328780, 5.89983646482, 5223.69391980220))

    array<vsop_term> R1 = array.new<vsop_term>()
    array.push(R1, vsop_term.new(0.00005641515, 4.29697744294, 6283.07584999140))
    array.push(R1, vsop_term.new(0.00001252975, 2.69402198377, 12566.15169998280))
    // New R1 terms
    array.push(R1, vsop_term.new(0.00000062523, 5.29856803136, 5884.92684658320))
    array.push(R1, vsop_term.new(0.00000007560, 5.63306582165, 77713.77146812050))
    array.push(R1, vsop_term.new(0.00000007711, 0.96836295859, 5507.55323866740))

    array<vsop_term> R2 = array.new<vsop_term>()
    array.push(R2, vsop_term.new(0.00004392, 0.0, 0.0))
    // New R2 term
    array.push(R2, vsop_term.new(0.00000049523, 3.14159265359, 0.0))

    R0sum = eval_vsop87(R0, t)
    R1sum = eval_vsop87(R1, t)
    R2sum = eval_vsop87(R2, t)
    R0sum + R1sum * t + R2sum * t * t


// /**
//  * Returns Earth’s heliocentric rectangular coordinates [x, y, z]
//  * Used to compute geocentric positions for other planets
//  * All values in AU
//  */


get_earth_helio_coords(float t) =>
    
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0, vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0, vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0, vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0, vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0, vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0, vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0, vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0, vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))
    // New L0 terms
    array.push(L0, vsop_term.new(0.00000901855, 2.04505443513, 26.29831979980))
    array.push(L0, vsop_term.new(0.00001199167, 1.10962946234, 1577.34354244780))
    array.push(L0, vsop_term.new(0.00000857223, 3.50849156957, 398.14900340820))
    array.push(L0, vsop_term.new(0.00000779786, 1.17882652114, 5223.69391980220))
    array.push(L0, vsop_term.new(0.00000990250, 5.23268129594, 5884.92684658320))
    array.push(L0, vsop_term.new(0.00000753141, 2.53339053818, 5507.55323866740))
    array.push(L0, vsop_term.new(0.00000505264, 4.58292599973, 18849.22754997420))
    array.push(L0, vsop_term.new(0.00000492379, 4.20506639861, 775.52261132400))
    array.push(L0, vsop_term.new(0.00000356672, 2.91954116867, 0.06731030280))
    array.push(L0, vsop_term.new(0.00000284125, 1.89869034186, 796.29800681640))

    // L1
    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(6283.31966747491, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1, vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))
    // New L1 terms
    array.push(L1, vsop_term.new(0.00000108977, 2.96618001993, 1577.34354244780))
    array.push(L1, vsop_term.new(0.00000093478, 2.59212835365, 18849.22754997420))
    array.push(L1, vsop_term.new(0.00000119261, 5.79557487799, 26.29831979980))
    array.push(L1, vsop_term.new(0.00000072122, 1.13840581212, 529.69096509460))
    array.push(L1, vsop_term.new(0.00000067768, 1.87472304791, 398.14900340820))
    array.push(L1, vsop_term.new(0.00000067327, 4.40918235168, 5507.55323866740))

    // L2
    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2, vsop_term.new(0.00000990990, 3.14159265359, 0.0))
    // New L2 terms
    array.push(L2, vsop_term.new(0.00000294833, 0.43717350256, 12566.15169998280))
    array.push(L2, vsop_term.new(0.00000027338, 0.05295636147, 3.52311834900))

    // Latitude (B) terms
    array<vsop_term> B0 = array.new<vsop_term>()
    array.push(B0, vsop_term.new(0.00000279620, 3.19870156017, 84334.66158130829))
    array.push(B0, vsop_term.new(0.00000101643, 5.42248619256, 5507.55323866740))
    // New B0
    array.push(B0, vsop_term.new(0.00000080445, 3.88013204458, 5223.69391980220))
    array.push(B0, vsop_term.new(0.00000043806, 3.70444689758, 2352.86615377180))
    array.push(B0, vsop_term.new(0.00000031933, 4.00026369781, 1577.34354244780))

    array<vsop_term> B1 = array.new<vsop_term>()
    array.push(B1, vsop_term.new(0.00000009030, 3.89729061890, 5507.55323866740))
    // New B1
    array.push(B1, vsop_term.new(0.00000006177, 1.73038850355, 5223.69391980220))


    // Evaluate
    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t

    B0sum = eval_vsop87(B0, t)
    B1sum = eval_vsop87(B1, t)
    lat_rad = B0sum + B1sum * t

    r = get_earth_helio_radius(t)
    x = r * math.cos(lat_rad) * math.cos(lon_rad)
    y = r * math.cos(lat_rad) * math.sin(lon_rad)
    z = r * math.sin(lat_rad)
    [x, y, z]


// Obliquity of the ecliptic (mean, in degrees)
get_obliquity(float t) =>
    float T = 10.0 * t  // Julian centuries
    23.439281 - 0.0130042 * T - 0.00000016 * T * T + 0.000000504 * T * T * T


// ─────────────────────── Earth Longitude Functions ───────────────────────

// Earth's heliocentric ecliptic longitude (in degrees, mod 360)
// This is the longitude of Earth from the Sun
get_earth_helio_lon(float t) =>
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0, vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0, vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0, vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0, vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0, vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0, vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0, vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0, vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(6283.31966747491, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1, vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2, vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    mod360(lon_rad * RAD_TO_DEG)


// ─────────────────────── Sun Functions ───────────────────────

// Geocentric ecliptic longitude of the Sun (in degrees, mod 360)
// This is Earth's heliocentric longitude + 180 degrees
get_sun_geo_lon(float t) =>
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0, vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0, vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0, vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0, vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0, vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0, vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0, vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0, vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(6283.31966747491, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1, vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2, vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    mod360(lon_rad * RAD_TO_DEG + 180.0)

// Geocentric ecliptic longitude speed of the Sun (in degrees per day)
get_sun_geo_speed(float t) =>
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0, vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0, vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0, vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0, vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0, vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0, vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0, vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0, vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(6283.31966747491, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1, vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2, vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)

    dL0 = eval_vsop87_derivative(L0, t)
    dL1 = eval_vsop87_derivative(L1, t)
    dL2 = eval_vsop87_derivative(L2, t)

    float dlon_rad_dt = dL0 + L1sum + t * dL1 + 2.0 * t * L2sum + t * t * dL2
    (dlon_rad_dt * RAD_TO_DEG / 36525.0) / 10 // Convert to deg/day (since t in centuries, 36525 days/century)

// Geocentric equatorial declination of the Sun (in degrees)
get_sun_decl(float t) =>
    float sun_ecl_lon_deg = get_sun_geo_lon(t)
    float sun_ecl_lat_deg = 0.0  // Sun ecliptic latitude is approximately 0
    float ecl_lon_rad = sun_ecl_lon_deg * (PI / 180.0)
    float ecl_lat_rad = sun_ecl_lat_deg * (PI / 180.0)
    float eps = get_obliquity(t)
    float eps_rad = eps * (PI / 180.0)
    float sin_delta = math.sin(ecl_lat_rad) * math.cos(eps_rad) + math.cos(ecl_lat_rad) * math.sin(eps_rad) * math.sin(ecl_lon_rad)
    math.asin(sin_delta) * (180.0 / PI)

// ─────────────────────── Future Projection Utilities ───────────────────────

// @function Get bar interval in milliseconds for current timeframe
// @returns (int) Time interval between bars in milliseconds
get_bar_gap_ms() =>
    int(timeframe.in_seconds(timeframe.period) * 1000)

// @function Calculate future timestamp for projection plotting
// @param current_time (int) Current bar time in milliseconds (use built-in 'time')
// @param bars_ahead (int) Number of bars to project into future
// @returns (int) Future timestamp suitable for xloc.bar_time and chart.point.from_time
get_future_time(int current_time, int bars_ahead) =>
    current_time + (get_bar_gap_ms() * bars_ahead)

// @function Check if current bar is suitable for drawing future projections
// @returns (bool) True on last bar when projections should be drawn
is_projection_bar() =>
    (barstate.islast or barstate.isrealtime) and not barstate.isconfirmed


// ════════════════════ MERCURY (mer_*) ════════════════════


// @function Computes Mercury's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
mer_get_helio_lon(float t) => 
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(4.40250710144, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.40989414977, 1.48302034195, 26087.90314157420))
    array.push(L0, vsop_term.new(0.05046294199, 4.47785489540, 52175.80628314840))
    array.push(L0, vsop_term.new(0.00855346844, 1.16520322459, 78263.70942472259))
    array.push(L0, vsop_term.new(0.00585979278, 4.22090402969, 104351.61256629678))
    array.push(L0, vsop_term.new(0.00165590362, 4.11969163181, 5661.33204915220))
    array.push(L0, vsop_term.new(0.00034561897, 0.77930768443, 130439.51570787099))
    array.push(L0, vsop_term.new(0.00007583476, 3.71348400510, 156527.41884944518))
    array.push(L0, vsop_term.new(0.00003559745, 1.51202675145, 1109.37855209340))
    array.push(L0, vsop_term.new(0.00001726011, 0.35832267096, 182615.32199101939))

    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(26088.14706222746, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.01126007832, 6.21703970996, 26087.90314157420))
    array.push(L1, vsop_term.new(0.00303471395, 3.05565472363, 52175.80628314840))
    array.push(L1, vsop_term.new(0.00121281763, 6.01064153797, 78263.70942472259))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00053049845, 0.0, 0.0))
    array.push(L2, vsop_term.new(0.00016903658, 4.69072300649, 26087.90314157420))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    mod360(lon_rad * RAD_TO_DEG)


// @function Computes Mercury's heliocentric ecliptic latitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic latitude in radians, range approximately [-0.122, +0.122]. Note: Returns radians, not degrees.
mer_get_helio_lat(float t) =>
    array<vsop_term> B0 = array.new<vsop_term>()
    array.push(B0, vsop_term.new(0.11737528962, 1.98357498767, 26087.90314157420))
    array.push(B0, vsop_term.new(0.02388076996, 5.03738959685, 52175.80628314840))
    array.push(B0, vsop_term.new(0.01222839532, 3.14159265359, 0.0))
    eval_vsop87(B0, t) // return radians directly


// @function Computes Mercury's heliocentric radius (distance from Sun) using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric radius in astronomical units (AU). Typical range is 0.31-0.47 AU.
mer_get_helio_radius(float t) =>
    array<vsop_term> R0 = array.new<vsop_term>()
    array.push(R0, vsop_term.new(0.39528271652, 0.0, 0.0))
    array.push(R0, vsop_term.new(0.07834131818, 6.19233722599, 26087.90314157420))
    array.push(R0, vsop_term.new(0.00795525558, 2.95989690104, 52175.80628314840))
    array.push(R0, vsop_term.new(0.00121281764, 6.01064153805, 78263.70942472259))
    array.push(R0, vsop_term.new(0.00021921969, 2.77820093972, 104351.61256629678))

    array<vsop_term> R1 = array.new<vsop_term>()
    array.push(R1, vsop_term.new(0.00217347739, 4.65617158663, 26087.90314157420))
    array.push(R1, vsop_term.new(0.00044141826, 1.42385543975, 52175.80628314840))

    array<vsop_term> R2 = array.new<vsop_term>()
    array.push(R2, vsop_term.new(0.00003117867, 3.08231840296, 26087.90314157420))

    R0sum = eval_vsop87(R0, t)
    R1sum = eval_vsop87(R1, t)
    R2sum = eval_vsop87(R2, t)
    R0sum + R1sum * t + R2sum * t * t


// @function Computes Mercury's geocentric longitude speed (rate of change over time).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric longitude speed in degrees per day. Negative values indicate retrograde motion (apparent backward movement).
mer_get_geo_speed(float t) =>
    // Mercury terms and sums
    array<vsop_term> L0_m = array.new<vsop_term>()
    array.push(L0_m, vsop_term.new(4.40250710144, 0.0, 0.0))
    array.push(L0_m, vsop_term.new(0.40989414977, 1.48302034195, 26087.90314157420))
    array.push(L0_m, vsop_term.new(0.05046294199, 4.47785489540, 52175.80628314840))
    array.push(L0_m, vsop_term.new(0.00855346844, 1.16520322459, 78263.70942472259))
    array.push(L0_m, vsop_term.new(0.00585979278, 4.22090402969, 104351.61256629678))
    array.push(L0_m, vsop_term.new(0.00165590362, 4.11969163181, 5661.33204915220))
    array.push(L0_m, vsop_term.new(0.00034561897, 0.77930768443, 130439.51570787099))
    array.push(L0_m, vsop_term.new(0.00007583476, 3.71348400510, 156527.41884944518))
    array.push(L0_m, vsop_term.new(0.00003559745, 1.51202675145, 1109.37855209340))
    array.push(L0_m, vsop_term.new(0.00001726011, 0.35832267096, 182615.32199101939))

    array<vsop_term> L1_m = array.new<vsop_term>()
    array.push(L1_m, vsop_term.new(26088.14706222746, 0.0, 0.0))
    array.push(L1_m, vsop_term.new(0.01126007832, 6.21703970996, 26087.90314157420))
    array.push(L1_m, vsop_term.new(0.00303471395, 3.05565472363, 52175.80628314840))
    array.push(L1_m, vsop_term.new(0.00121281763, 6.01064153797, 78263.70942472259))

    array<vsop_term> L2_m = array.new<vsop_term>()
    array.push(L2_m, vsop_term.new(0.00053049845, 0.0, 0.0))
    array.push(L2_m, vsop_term.new(0.00016903658, 4.69072300649, 26087.90314157420))

    float L0sum_m = eval_vsop87(L0_m, t)
    float L1sum_m = eval_vsop87(L1_m, t)
    float L2sum_m = eval_vsop87(L2_m, t)
    float lon_rad_m = L0sum_m + L1sum_m * t + L2sum_m * t * t

    float dL0_m = eval_vsop87_derivative(L0_m, t)
    float dL1_m = eval_vsop87_derivative(L1_m, t)
    float dL2_m = eval_vsop87_derivative(L2_m, t)
    float dlon_dt_m = dL0_m + L1sum_m + t * dL1_m + 2.0 * t * L2sum_m + t * t * dL2_m

    array<vsop_term> B0_m = array.new<vsop_term>()
    array.push(B0_m, vsop_term.new(0.11737528962, 1.98357498767, 26087.90314157420))
    array.push(B0_m, vsop_term.new(0.02388076996, 5.03738959685, 52175.80628314840))
    array.push(B0_m, vsop_term.new(0.01222839532, 3.14159265359, 0.0))
    float lat_rad_m = eval_vsop87(B0_m, t)
    float dlat_dt_m = eval_vsop87_derivative(B0_m, t)

    array<vsop_term> R0_m = array.new<vsop_term>()
    array.push(R0_m, vsop_term.new(0.39528271652, 0.0, 0.0))
    array.push(R0_m, vsop_term.new(0.07834131818, 6.19233722599, 26087.90314157420))
    array.push(R0_m, vsop_term.new(0.00795525558, 2.95989690104, 52175.80628314840))
    array.push(R0_m, vsop_term.new(0.00121281764, 6.01064153805, 78263.70942472259))
    array.push(R0_m, vsop_term.new(0.00021921969, 2.77820093972, 104351.61256629678))

    array<vsop_term> R1_m = array.new<vsop_term>()
    array.push(R1_m, vsop_term.new(0.00217347739, 4.65617158663, 26087.90314157420))
    array.push(R1_m, vsop_term.new(0.00044141826, 1.42385543975, 52175.80628314840))

    array<vsop_term> R2_m = array.new<vsop_term>()
    array.push(R2_m, vsop_term.new(0.00003117867, 3.08231840296, 26087.90314157420))

    float R0sum_m = eval_vsop87(R0_m, t)
    float R1sum_m = eval_vsop87(R1_m, t)
    float R2sum_m = eval_vsop87(R2_m, t)
    float r_m = R0sum_m + R1sum_m * t + R2sum_m * t * t

    float dR0_m = eval_vsop87_derivative(R0_m, t)
    float dR1_m = eval_vsop87_derivative(R1_m, t)
    float dR2_m = eval_vsop87_derivative(R2_m, t)
    float dr_dt_m = dR0_m + R1sum_m + t * dR1_m + 2.0 * t * R2sum_m + t * t * dR2_m

    float cl_m = math.cos(lon_rad_m)
    float sl_m = math.sin(lon_rad_m)
    float cb_m = math.cos(lat_rad_m)
    float sb_m = math.sin(lat_rad_m)

    float x_m = r_m * cb_m * cl_m
    float y_m = r_m * cb_m * sl_m

    float vx_m = dr_dt_m * cb_m * cl_m - r_m * dlat_dt_m * sb_m * cl_m - r_m * cb_m * sl_m * dlon_dt_m
    float vy_m = dr_dt_m * cb_m * sl_m - r_m * dlat_dt_m * sb_m * sl_m + r_m * cb_m * cl_m * dlon_dt_m

    // Earth terms and sums (from get_earth_helio_coords)
    array<vsop_term> L0_e = array.new<vsop_term>()
    array.push(L0_e, vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0_e, vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0_e, vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0_e, vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0_e, vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0_e, vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0_e, vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0_e, vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0_e, vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0_e, vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<vsop_term> L1_e = array.new<vsop_term>()
    array.push(L1_e, vsop_term.new(6283.31966747491, 0.0, 0.0))
    array.push(L1_e, vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1_e, vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1_e, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<vsop_term> L2_e = array.new<vsop_term>()
    array.push(L2_e, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2_e, vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    float L0sum_e = eval_vsop87(L0_e, t)
    float L1sum_e = eval_vsop87(L1_e, t)
    float L2sum_e = eval_vsop87(L2_e, t)
    float lon_rad_e = L0sum_e + L1sum_e * t + L2sum_e * t * t

    float dL0_e = eval_vsop87_derivative(L0_e, t)
    float dL1_e = eval_vsop87_derivative(L1_e, t)
    float dL2_e = eval_vsop87_derivative(L2_e, t)
    float dlon_dt_e = dL0_e + L1sum_e + t * dL1_e + 2.0 * t * L2sum_e + t * t * dL2_e

    array<vsop_term> B0_e = array.new<vsop_term>()
    array.push(B0_e, vsop_term.new(0.00000279620, 3.19870156017, 84334.66158130829))
    array.push(B0_e, vsop_term.new(0.00000101643, 5.42248619256, 5507.55323866740))

    array<vsop_term> B1_e = array.new<vsop_term>()
    array.push(B1_e, vsop_term.new(0.00000009030, 3.89729061890, 5507.55323866740))

    float B0sum_e = eval_vsop87(B0_e, t)
    float B1sum_e = eval_vsop87(B1_e, t)
    float lat_rad_e = B0sum_e + B1sum_e * t

    float dB0_e = eval_vsop87_derivative(B0_e, t)
    float dB1_e = eval_vsop87_derivative(B1_e, t)
    float dlat_dt_e = dB0_e + B1sum_e + t * dB1_e

    array<vsop_term> R0_e = array.new<vsop_term>()
    array.push(R0_e, vsop_term.new(1.00000101778, 0.0, 0.0))
    array.push(R0_e, vsop_term.new(0.01670861753, 3.09846350771, 6283.07584999140))
    array.push(R0_e, vsop_term.new(0.00013956023, 3.05524609620, 12566.15169998280))
    array.push(R0_e, vsop_term.new(0.00003083720, 5.19846674381, 77713.77146812050))
    array.push(R0_e, vsop_term.new(0.00001628461, 1.17387749012, 5753.38488489680))

    array<vsop_term> R1_e = array.new<vsop_term>()
    array.push(R1_e, vsop_term.new(0.00005641515, 4.29697744294, 6283.07584999140))
    array.push(R1_e, vsop_term.new(0.00001252975, 2.69402198377, 12566.15169998280))

    array<vsop_term> R2_e = array.new<vsop_term>()
    array.push(R2_e, vsop_term.new(0.00004392, 0.0, 0.0))

    float R0sum_e = eval_vsop87(R0_e, t)
    float R1sum_e = eval_vsop87(R1_e, t)
    float R2sum_e = eval_vsop87(R2_e, t)
    float r_e = R0sum_e + R1sum_e * t + R2sum_e * t * t

    float dR0_e = eval_vsop87_derivative(R0_e, t)
    float dR1_e = eval_vsop87_derivative(R1_e, t)
    float dR2_e = eval_vsop87_derivative(R2_e, t)
    float dr_dt_e = dR0_e + R1sum_e + t * dR1_e + 2.0 * t * R2sum_e + t * t * dR2_e

    float cl_e = math.cos(lon_rad_e)
    float sl_e = math.sin(lon_rad_e)
    float cb_e = math.cos(lat_rad_e)
    float sb_e = math.sin(lat_rad_e)

    float x_e = r_e * cb_e * cl_e
    float y_e = r_e * cb_e * sl_e

    float vx_e = dr_dt_e * cb_e * cl_e - r_e * dlat_dt_e * sb_e * cl_e - r_e * cb_e * sl_e * dlon_dt_e
    float vy_e = dr_dt_e * cb_e * sl_e - r_e * dlat_dt_e * sb_e * sl_e + r_e * cb_e * cl_e * dlon_dt_e

    // Geocentric
    float geo_x = x_m - x_e
    float geo_y = y_m - y_e
    float v_geo_x = vx_m - vx_e
    float v_geo_y = vy_m - vy_e

    float denom = geo_x * geo_x + geo_y * geo_y
    float dlambda_dt = (geo_x * v_geo_y - geo_y * v_geo_x) / denom

    dlambda_dt * RAD_TO_DEG / 365250.0


// ────────────────────────────── GEO ──────────────────────────────
// @function Computes Mercury's geocentric ecliptic longitude (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric ecliptic longitude in degrees, normalized to range [0, 360).
mer_get_geo_lon(float t) => // accurate might be able to improve by adding more terms to earth 
    [earth_x, earth_y, earth_z] = get_earth_helio_coords(t)
    mercury_lon_rad = mer_get_helio_lon(t) * PI / 180.0
    mercury_b_rad = mer_get_helio_lat(t) * PI / 180.0
    mercury_r = mer_get_helio_radius(t)
    mercury_x = mercury_r * math.cos(mercury_b_rad) * math.cos(mercury_lon_rad)
    mercury_y = mercury_r * math.cos(mercury_b_rad) * math.sin(mercury_lon_rad)
    geo_x = mercury_x - earth_x
    geo_y = mercury_y - earth_y
    mod360(custom_atan2(geo_y, geo_x) * RAD_TO_DEG)


// @function Computes Mercury's geocentric ecliptic latitude (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric ecliptic latitude in degrees, range approximately [-7, +7].
mer_get_geo_ecl_lat(float t) =>
    lon_rad = mer_get_helio_lon(t) * PI / 180.0
    lat_rad = mer_get_helio_lat(t)  // already radians
    r = mer_get_helio_radius(t)

    mercury_x = r * math.cos(lat_rad) * math.cos(lon_rad)
    mercury_y = r * math.cos(lat_rad) * math.sin(lon_rad)
    mercury_z = r * math.sin(lat_rad)

    [earth_x, earth_y, earth_z] = get_earth_helio_coords(t)

    geo_x = mercury_x - earth_x
    geo_y = mercury_y - earth_y
    geo_z = mercury_z - earth_z

    r_xy = math.sqrt(geo_x * geo_x + geo_y * geo_y)
    custom_atan2(geo_z, r_xy) * RAD_TO_DEG

// @function Computes Mercury's geocentric equatorial declination (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric equatorial declination in degrees, range [-90, +90] where positive is north.
mer_get_geo_decl(float t) =>
    float ecl_lon_deg = mer_get_geo_lon(t)
    float ecl_lat_deg = mer_get_geo_ecl_lat(t)
    float ecl_lon_rad = ecl_lon_deg * PI / 180.0
    float ecl_lat_rad = ecl_lat_deg * PI / 180.0
    float epsilon_deg = get_obliquity(t)
    float epsilon_rad = epsilon_deg * PI / 180.0

    float sin_delta = math.sin(ecl_lat_rad) * math.cos(epsilon_rad) + math.cos(ecl_lat_rad) * math.sin(epsilon_rad) * math.sin(ecl_lon_rad)
    float delta_rad = math.asin(sin_delta)
    delta_rad * RAD_TO_DEG


// ════════════════════ VENUS (ven_*) ════════════════════


// @function Computes Venus's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
ven_get_helio_lon(float t) =>
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(3.17614666774, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.01353968419, 5.59313319619, 10213.28554621100))
    array.push(L0, vsop_term.new(0.00089891645, 5.30650047764, 20426.57109242200))
    array.push(L0, vsop_term.new(0.00005477194, 4.41630661466, 7860.41939243920))
    array.push(L0, vsop_term.new(0.00003455741, 2.69964470778, 11790.62908865880))
    array.push(L0, vsop_term.new(0.00002372061, 2.99377542079, 3930.20969621960))
    array.push(L0, vsop_term.new(0.00001317108, 5.18668228402, 26.29831979980))
    array.push(L0, vsop_term.new(0.00001200521, 6.15357116043, 30639.85663863300))
    array.push(L0, vsop_term.new(0.00000761380, 1.95014702120, 529.69096509460))
    array.push(L0, vsop_term.new(0.00000707676, 1.06466707214, 775.52261132400))

    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(10213.52943052898, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.00095617813, 2.46406511110, 10213.28554621100))
    array.push(L1, vsop_term.new(0.00007787201, 0.62478482220, 20426.57109242200))
    array.push(L1, vsop_term.new(0.00000951697, 1.31712790883, 26.29831979980))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00054127076, 0.0, 0.0))
    array.push(L2, vsop_term.new(0.00003891460, 0.34514360047, 10213.28554621100))
    array.push(L2, vsop_term.new(0.00000266136, 4.80307477493, 20426.57109242200))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    mod360(lon_rad * RAD_TO_DEG)


// @function Computes Venus's heliocentric ecliptic latitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic latitude in radians, range approximately [-0.1, +0.1]. Note: Returns radians, not degrees.
ven_get_helio_lat(float t) =>
    array<vsop_term> B0 = array.new<vsop_term>()
    array.push(B0, vsop_term.new(0.05923638472, 0.26702775813, 10213.28554621100))
    array.push(B0, vsop_term.new(0.00040107978, 1.14737178112, 20426.57109242200))
    array.push(B0, vsop_term.new(0.00032814918, 3.14159265359, 0.0))
    eval_vsop87(B0, t) // returns radians


// @function Computes Venus's heliocentric radius (distance from Sun) using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric radius in astronomical units (AU). Typical range is 0.72-0.73 AU.
ven_get_helio_radius(float t) =>
    array<vsop_term> R0 = array.new<vsop_term>()
    array.push(R0, vsop_term.new(0.72334820891, 0.0, 0.0))
    array.push(R0, vsop_term.new(0.00489824185, 4.02151832268, 10213.28554621100))
    array.push(R0, vsop_term.new(0.00001658058, 4.90206728031, 20426.57109242200))
    array.push(R0, vsop_term.new(0.00001632093, 2.84548851892, 7860.41939243920))
    array.push(R0, vsop_term.new(0.00001378048, 1.12846590600, 11790.62908865880))

    array<vsop_term> R1 = array.new<vsop_term>()
    array.push(R1, vsop_term.new(0.00034551039, 0.89198710598, 10213.28554621100))

    array<vsop_term> R2 = array.new<vsop_term>()
    array.push(R2, vsop_term.new(0.00001406587, 5.06366395190, 10213.28554621100))

    R0sum = eval_vsop87(R0, t)
    R1sum = eval_vsop87(R1, t)
    R2sum = eval_vsop87(R2, t)
    R0sum + R1sum * t + R2sum * t * t


// @function Computes Venus's geocentric longitude speed (rate of change over time).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric longitude speed in degrees per day. Negative values indicate retrograde motion (apparent backward movement).
ven_get_geo_speed(float t) =>
    // Venus terms and sums
    array<vsop_term> L0_v = array.new<vsop_term>()
    array.push(L0_v, vsop_term.new(3.17614669689, 0.0, 0.0))
    array.push(L0_v, vsop_term.new(0.01353968419, 5.59313319619, 10213.28554621100))
    array.push(L0_v, vsop_term.new(0.00089891645, 5.30650048468, 20426.57109242200))
    array.push(L0_v, vsop_term.new(0.00005477201, 4.41630661466, 7860.41939243920))
    array.push(L0_v, vsop_term.new(0.00003455741, 2.69964447820, 11790.62908865880))

    array<vsop_term> L1_v = array.new<vsop_term>()
    array.push(L1_v, vsop_term.new(10213.52943052898, 0.0, 0.0))
    array.push(L1_v, vsop_term.new(0.00095707712, 2.46424448979, 10213.28554621100))

    array<vsop_term> L2_v = array.new<vsop_term>()
    array.push(L2_v, vsop_term.new(0.00054127076, 0.0, 0.0))

    float L0sum_v = eval_vsop87(L0_v, t)
    float L1sum_v = eval_vsop87(L1_v, t)
    float L2sum_v = eval_vsop87(L2_v, t)
    float lon_rad_v = L0sum_v + L1sum_v * t + L2sum_v * t * t

    float dL0_v = eval_vsop87_derivative(L0_v, t)
    float dL1_v = eval_vsop87_derivative(L1_v, t)
    float dL2_v = eval_vsop87_derivative(L2_v, t)
    float dlon_dt_v = dL0_v + L1sum_v + t * dL1_v + 2.0 * t * L2sum_v + t * t * dL2_v

    array<vsop_term> B0_v = array.new<vsop_term>()
    array.push(B0_v, vsop_term.new(0.05923638472, 0.26702775812, 10213.28554621100))
    float lat_rad_v = eval_vsop87(B0_v, t)
    float dlat_dt_v = eval_vsop87_derivative(B0_v, t)

    array<vsop_term> R0_v = array.new<vsop_term>()
    array.push(R0_v, vsop_term.new(0.72334820905, 0.0, 0.0))
    array.push(R0_v, vsop_term.new(0.00489824182, 4.02151831717, 10213.28554621100))

    array<vsop_term> R1_v = array.new<vsop_term>()
    array.push(R1_v, vsop_term.new(0.00034551041, 0.89198710598, 10213.28554621100))

    float R0sum_v = eval_vsop87(R0_v, t)
    float R1sum_v = eval_vsop87(R1_v, t)
    float r_v = R0sum_v + R1sum_v * t

    float dR0_v = eval_vsop87_derivative(R0_v, t)
    float dR1_v = eval_vsop87_derivative(R1_v, t)
    float dr_dt_v = dR0_v + R1sum_v + t * dR1_v

    float cl_v = math.cos(lon_rad_v)
    float sl_v = math.sin(lon_rad_v)
    float cb_v = math.cos(lat_rad_v)
    float sb_v = math.sin(lat_rad_v)

    float x_v = r_v * cb_v * cl_v
    float y_v = r_v * cb_v * sl_v

    float vx_v = dr_dt_v * cb_v * cl_v - r_v * dlat_dt_v * sb_v * cl_v - r_v * cb_v * sl_v * dlon_dt_v
    float vy_v = dr_dt_v * cb_v * sl_v - r_v * dlat_dt_v * sb_v * sl_v + r_v * cb_v * cl_v * dlon_dt_v


    // Earth terms and sums (from get_earth_helio_coords)
    array<vsop_term> L0_e = array.new<vsop_term>()
    array.push(L0_e, vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0_e, vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0_e, vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0_e, vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0_e, vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0_e, vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0_e, vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0_e, vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0_e, vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0_e, vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<vsop_term> L1_e = array.new<vsop_term>()
    array.push(L1_e, vsop_term.new(6283.31966747491, 0.0, 0.0))
    array.push(L1_e, vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1_e, vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1_e, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<vsop_term> L2_e = array.new<vsop_term>()
    array.push(L2_e, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2_e, vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    float L0sum_e = eval_vsop87(L0_e, t)
    float L1sum_e = eval_vsop87(L1_e, t)
    float L2sum_e = eval_vsop87(L2_e, t)
    float lon_rad_e = L0sum_e + L1sum_e * t + L2sum_e * t * t

    float dL0_e = eval_vsop87_derivative(L0_e, t)
    float dL1_e = eval_vsop87_derivative(L1_e, t)
    float dL2_e = eval_vsop87_derivative(L2_e, t)
    float dlon_dt_e = dL0_e + L1sum_e + t * dL1_e + 2.0 * t * L2sum_e + t * t * dL2_e

    array<vsop_term> B0_e = array.new<vsop_term>()
    array.push(B0_e, vsop_term.new(0.00000279620, 3.19870156017, 84334.66158130829))
    array.push(B0_e, vsop_term.new(0.00000101643, 5.42248619256, 5507.55323866740))

    array<vsop_term> B1_e = array.new<vsop_term>()
    array.push(B1_e, vsop_term.new(0.00000009030, 3.89729061890, 5507.55323866740))

    float B0sum_e = eval_vsop87(B0_e, t)
    float B1sum_e = eval_vsop87(B1_e, t)
    float lat_rad_e = B0sum_e + B1sum_e * t

    float dB0_e = eval_vsop87_derivative(B0_e, t)
    float dB1_e = eval_vsop87_derivative(B1_e, t)
    float dlat_dt_e = dB0_e + B1sum_e + t * dB1_e

    array<vsop_term> R0_e = array.new<vsop_term>()
    array.push(R0_e, vsop_term.new(1.00000101778, 0.0, 0.0))
    array.push(R0_e, vsop_term.new(0.01670861753, 3.09846350771, 6283.07584999140))
    array.push(R0_e, vsop_term.new(0.00013956023, 3.05524609620, 12566.15169998280))
    array.push(R0_e, vsop_term.new(0.00003083720, 5.19846674381, 77713.77146812050))
    array.push(R0_e, vsop_term.new(0.00001628461, 1.17387749012, 5753.38488489680))

    array<vsop_term> R1_e = array.new<vsop_term>()
    array.push(R1_e, vsop_term.new(0.00005641515, 4.29697744294, 6283.07584999140))
    array.push(R1_e, vsop_term.new(0.00001252975, 2.69402198377, 12566.15169998280))

    array<vsop_term> R2_e = array.new<vsop_term>()
    array.push(R2_e, vsop_term.new(0.00004392, 0.0, 0.0))

    float R0sum_e = eval_vsop87(R0_e, t)
    float R1sum_e = eval_vsop87(R1_e, t)
    float R2sum_e = eval_vsop87(R2_e, t)
    float r_e = R0sum_e + R1sum_e * t + R2sum_e * t * t

    float dR0_e = eval_vsop87_derivative(R0_e, t)
    float dR1_e = eval_vsop87_derivative(R1_e, t)
    float dR2_e = eval_vsop87_derivative(R2_e, t)
    float dr_dt_e = dR0_e + R1sum_e + t * dR1_e + 2.0 * t * R2sum_e + t * t * dR2_e

    float cl_e = math.cos(lon_rad_e)
    float sl_e = math.sin(lon_rad_e)
    float cb_e = math.cos(lat_rad_e)
    float sb_e = math.sin(lat_rad_e)

    float x_e = r_e * cb_e * cl_e
    float y_e = r_e * cb_e * sl_e

    float vx_e = dr_dt_e * cb_e * cl_e - r_e * dlat_dt_e * sb_e * cl_e - r_e * cb_e * sl_e * dlon_dt_e
    float vy_e = dr_dt_e * cb_e * sl_e - r_e * dlat_dt_e * sb_e * sl_e + r_e * cb_e * cl_e * dlon_dt_e

    // Geocentric
    float geo_x = x_v - x_e
    float geo_y = y_v - y_e
    float v_geo_x = vx_v - vx_e
    float v_geo_y = vy_v - vy_e

    float denom = geo_x * geo_x + geo_y * geo_y
    float dlambda_dt = (geo_x * v_geo_y - geo_y * v_geo_x) / denom

    dlambda_dt * RAD_TO_DEG / 365250.0


// ────────────────────────────── GEO ──────────────────────────────
// @function Computes Venus's geocentric ecliptic longitude (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric ecliptic longitude in degrees, normalized to range [0, 360).
ven_get_geo_lon(float t) =>
    [earth_x, earth_y, earth_z] = get_earth_helio_coords(t)
    venus_lon_rad = ven_get_helio_lon(t) * PI / 180.0
    venus_b_rad = ven_get_helio_lat(t) * PI / 180.0
    venus_r = ven_get_helio_radius(t)
    venus_x = venus_r * math.cos(venus_b_rad) * math.cos(venus_lon_rad)
    venus_y = venus_r * math.cos(venus_b_rad) * math.sin(venus_lon_rad)
    geo_x = venus_x - earth_x
    geo_y = venus_y - earth_y
    mod360(custom_atan2(geo_y, geo_x) * RAD_TO_DEG)


// @function Computes Venus's geocentric ecliptic latitude (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric ecliptic latitude in degrees, range approximately [-9, +9].
ven_get_geo_ecl_lat(float t) =>
    lon_rad = ven_get_helio_lon(t) * PI / 180.0
    lat_rad = ven_get_helio_lat(t)  // already radians
    r = ven_get_helio_radius(t)

    venus_x = r * math.cos(lat_rad) * math.cos(lon_rad)
    venus_y = r * math.cos(lat_rad) * math.sin(lon_rad)
    venus_z = r * math.sin(lat_rad)

    [earth_x, earth_y, earth_z] = get_earth_helio_coords(t)

    geo_x = venus_x - earth_x
    geo_y = venus_y - earth_y
    geo_z = venus_z - earth_z

    r_xy = math.sqrt(geo_x * geo_x + geo_y * geo_y)
    custom_atan2(geo_z, r_xy) * RAD_TO_DEG


// @function Computes Venus's geocentric equatorial declination (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Geocentric equatorial declination in degrees, range [-90, +90] where positive is north.
ven_get_geo_decl(float t) =>
    float ecl_lon_deg = ven_get_geo_lon(t)
    float ecl_lat_deg = ven_get_geo_ecl_lat(t)
    float ecl_lon_rad = ecl_lon_deg * PI / 180.0
    float ecl_lat_rad = ecl_lat_deg * PI / 180.0
    float epsilon_deg = get_obliquity(t)
    float epsilon_rad = epsilon_deg * PI / 180.0

    float sin_delta = math.sin(ecl_lat_rad) * math.cos(epsilon_rad) + math.cos(ecl_lat_rad) * math.sin(epsilon_rad) * math.sin(ecl_lon_rad)
    float delta_rad = math.asin(sin_delta)
    delta_rad * RAD_TO_DEG


// ════════════════════ MARS (mar_*) ════════════════════


// @function Computes Mars's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
mar_get_helio_lon(float t) =>
    array<vsop_term> L0 = array.new<vsop_term>()
    array.push(L0, vsop_term.new(6.20347711581, 0.0, 0.0))
    array.push(L0, vsop_term.new(0.18656368093, 5.05037100303, 3340.61242669980))
    array.push(L0, vsop_term.new(0.01108216792, 5.40099836958, 6681.22485339960))
    array.push(L0, vsop_term.new(0.00091798394, 5.75478744667, 10021.83728009940))
    array.push(L0, vsop_term.new(0.00027744987, 5.97049512942, 3.52311834900))
    array.push(L0, vsop_term.new(0.00010610235, 2.93958560338, 2281.23049651060))
    array.push(L0, vsop_term.new(0.00012315897, 0.84956081238, 2810.92146160520))
    array.push(L0, vsop_term.new(0.00008926772, 4.15697846427, 0.01725365220))
    array.push(L0, vsop_term.new(0.00008715691, 6.11005159792, 13362.44970679920))
    array.push(L0, vsop_term.new(0.00006797556, 0.36462243626, 398.14900340820))

    array<vsop_term> L1 = array.new<vsop_term>()
    array.push(L1, vsop_term.new(3340.85627474342, 0.0, 0.0))
    array.push(L1, vsop_term.new(0.01458227051, 3.60426053609, 3340.61242669980))
    array.push(L1, vsop_term.new(0.00164901343, 3.92631250962, 6681.22485339960))
    array.push(L1, vsop_term.new(0.00019963338, 4.26594061030, 10021.83728009940))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00058015791, 2.04979463279, 3340.61242669980))
    array.push(L2, vsop_term.new(0.00054187645, 0.0, 0.0))
    array.push(L2, vsop_term.new(0.00013908426, 2.45742359888, 6681.22485339960))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    mod360(lon_rad * RAD_TO_DEG)


// @function Computes Mars's heliocentric ecliptic latitude using VSOP87 theory.
