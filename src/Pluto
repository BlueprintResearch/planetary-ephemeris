import BlueprintResearch/lib_vsop_core/1 as core

library("lib_meeus_pluto")

var float PI = math.pi
var float DEG_TO_RAD = PI / 180.0
var float RAD_TO_DEG = 180.0 / PI
var float DAYS_PER_CENTURY = 36525.0

// Obliquity of the ecliptic (in degrees)
get_obliquity(float t) =>
    float base = 23.0 + 26.0 / 60.0 + 21.448 / 3600.0
    float delta = 46.815 * t + 0.00059 * t*t - 0.001813 * t*t*t
    base - delta / 3600.0

// @function Computes Pluto's heliocentric ecliptic longitude using Meeus truncated analytical series.
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360). Accurate within ±1 century from J2000.
export get_helio_lon(float t) =>
    float d = DAYS_PER_CENTURY * t
    float S = 50.03 + 0.033459652 * d
    float P = 238.95 + 0.003968789 * d
    float sp = S - P
    float lon = 238.9508 + 0.00400703 * d
    lon += -19.799 * math.sin(DEG_TO_RAD * P) + 19.848 * math.cos(DEG_TO_RAD * P)
    lon += 0.897 * math.sin(DEG_TO_RAD * 2 * P) - 4.956 * math.cos(DEG_TO_RAD * 2 * P)
    lon += 0.610 * math.sin(DEG_TO_RAD * 3 * P) + 1.211 * math.cos(DEG_TO_RAD * 3 * P)
    lon += -0.341 * math.sin(DEG_TO_RAD * 4 * P) - 0.190 * math.cos(DEG_TO_RAD * 4 * P)
    lon += 0.128 * math.sin(DEG_TO_RAD * 5 * P) - 0.034 * math.cos(DEG_TO_RAD * 5 * P)
    lon += -0.038 * math.sin(DEG_TO_RAD * 6 * P) + 0.031 * math.cos(DEG_TO_RAD * 6 * P)
    lon += 0.020 * math.sin(DEG_TO_RAD * sp) - 0.010 * math.cos(DEG_TO_RAD * sp)
    core.mod360(lon)

// @function Computes Pluto's heliocentric ecliptic latitude using Meeus truncated analytical series.
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Heliocentric ecliptic latitude in degrees, range approximately [-17, +17]. Accurate within ±1 century from J2000.
export get_helio_lat(float t) =>
    float d = DAYS_PER_CENTURY * t
    float S = 50.03 + 0.033459652 * d
    float P = 238.95 + 0.003968789 * d
    float sp = S - P
    float lat = -3.9082
    lat += -5.453 * math.sin(DEG_TO_RAD * P) - 14.975 * math.cos(DEG_TO_RAD * P)
    lat += 3.527 * math.sin(DEG_TO_RAD * 2 * P) + 1.673 * math.cos(DEG_TO_RAD * 2 * P)
    lat += -1.051 * math.sin(DEG_TO_RAD * 3 * P) + 0.328 * math.cos(DEG_TO_RAD * 3 * P)
    lat += 0.179 * math.sin(DEG_TO_RAD * 4 * P) - 0.292 * math.cos(DEG_TO_RAD * 4 * P)
    lat += 0.019 * math.sin(DEG_TO_RAD * 5 * P) + 0.100 * math.cos(DEG_TO_RAD * 5 * P)
    lat += -0.031 * math.sin(DEG_TO_RAD * 6 * P) - 0.026 * math.cos(DEG_TO_RAD * 6 * P)
    lat += 0.011 * math.cos(DEG_TO_RAD * sp)
    lat

// @function Computes Pluto's heliocentric radius (distance from Sun) using Meeus truncated analytical series.
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Heliocentric radius in astronomical units (AU). Typical range is 29.6-49.3 AU. Accurate within ±1 century from J2000.
export get_helio_radius(float t) =>
    float d = DAYS_PER_CENTURY * t
    float P = 238.95 + 0.003968789 * d
    float r = 40.72
    r += 6.68 * math.sin(DEG_TO_RAD * P) + 6.90 * math.cos(DEG_TO_RAD * P)
    r += -1.18 * math.sin(DEG_TO_RAD * 2 * P) - 0.03 * math.cos(DEG_TO_RAD * 2 * P)
    r += 0.15 * math.sin(DEG_TO_RAD * 3 * P) - 0.14 * math.cos(DEG_TO_RAD * 3 * P)
    r

// @function Computes Pluto's geocentric ecliptic longitude (as seen from Earth).
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Geocentric ecliptic longitude in degrees, normalized to range [0, 360).
export get_geo_lon(float t) =>
    float t_mill = t / 10.0
    [earth_x, earth_y, earth_z] = core.get_earth_helio_coords(t_mill)
    float pluto_lon_rad = get_helio_lon(t) * DEG_TO_RAD
    float pluto_lat_rad = get_helio_lat(t) * DEG_TO_RAD
    float pluto_r = get_helio_radius(t)
    float pluto_x = pluto_r * math.cos(pluto_lat_rad) * math.cos(pluto_lon_rad)
    float pluto_y = pluto_r * math.cos(pluto_lat_rad) * math.sin(pluto_lon_rad)
    float geo_x = pluto_x - earth_x
    float geo_y = pluto_y - earth_y
    core.mod360(core.custom_atan2(geo_y, geo_x) * RAD_TO_DEG)

// @function Computes Pluto's geocentric ecliptic latitude (as seen from Earth).
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Geocentric ecliptic latitude in degrees, range approximately [-17, +17].
export get_geo_ecl_lat(float t) =>
    float t_mill = t / 10.0
    float lon_rad = get_helio_lon(t) * DEG_TO_RAD
    float lat_rad = get_helio_lat(t) * DEG_TO_RAD
    float r = get_helio_radius(t)
    float pluto_x = r * math.cos(lat_rad) * math.cos(lon_rad)
    float pluto_y = r * math.cos(lat_rad) * math.sin(lon_rad)
    float pluto_z = r * math.sin(lat_rad)
    [earth_x, earth_y, earth_z] = core.get_earth_helio_coords(t_mill)
    float geo_x = pluto_x - earth_x
    float geo_y = pluto_y - earth_y
    float geo_z = pluto_z - earth_z
    float r_xy = math.sqrt(geo_x * geo_x + geo_y * geo_y)
    core.custom_atan2(geo_z, r_xy) * RAD_TO_DEG

// @function Computes Pluto's geocentric equatorial declination (as seen from Earth).
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Geocentric equatorial declination in degrees, range [-90, +90] where positive is north.
export get_geo_decl(float t) =>
    float ecl_lon_deg = get_geo_lon(t)
    float ecl_lat_deg = get_geo_ecl_lat(t)
    float ecl_lon_rad = ecl_lon_deg * DEG_TO_RAD
    float ecl_lat_rad = ecl_lat_deg * DEG_TO_RAD
    float eps = get_obliquity(t)
    float eps_rad = eps * DEG_TO_RAD
    float sin_delta = math.sin(ecl_lat_rad) * math.cos(eps_rad) + math.cos(ecl_lat_rad) * math.sin(eps_rad) * math.sin(ecl_lon_rad)
    math.asin(sin_delta) * RAD_TO_DEG

// @function Computes Pluto's geocentric longitude speed (rate of change over time).
// @param t (float) Julian centuries from J2000.0 (use core.get_julian_centuries(time)).
// @returns (float) Geocentric longitude speed in degrees per day. Negative values indicate retrograde motion (apparent backward movement).
export get_geo_speed(float t) =>
    float days_per_cent = 36525.0
    float d = days_per_cent * t
    float S = 50.03 + 0.033459652 * d
    float P = 238.95 + 0.003968789 * d
    float sp = S - P

    float dS_dt = 0.033459652 * days_per_cent
    float dP_dt = 0.003968789 * days_per_cent
    float dsp_dt = dS_dt - dP_dt

    float dlon_dt_deg = 0.00400703 * days_per_cent
    dlon_dt_deg += -19.799 * math.cos(DEG_TO_RAD * P) * DEG_TO_RAD * dP_dt + 19.848 * (-math.sin(DEG_TO_RAD * P)) * DEG_TO_RAD * dP_dt
    dlon_dt_deg += 0.897 * math.cos(DEG_TO_RAD * 2 * P) * DEG_TO_RAD * 2 * dP_dt + (-4.956) * (-math.sin(DEG_TO_RAD * 2 * P)) * DEG_TO_RAD * 2 * dP_dt
    dlon_dt_deg += 0.610 * math.cos(DEG_TO_RAD * 3 * P) * DEG_TO_RAD * 3 * dP_dt + 1.211 * (-math.sin(DEG_TO_RAD * 3 * P)) * DEG_TO_RAD * 3 * dP_dt
    dlon_dt_deg += -0.341 * math.cos(DEG_TO_RAD * 4 * P) * DEG_TO_RAD * 4 * dP_dt + (-0.190) * (-math.sin(DEG_TO_RAD * 4 * P)) * DEG_TO_RAD * 4 * dP_dt
    dlon_dt_deg += 0.128 * math.cos(DEG_TO_RAD * 5 * P) * DEG_TO_RAD * 5 * dP_dt + (-0.034) * (-math.sin(DEG_TO_RAD * 5 * P)) * DEG_TO_RAD * 5 * dP_dt
    dlon_dt_deg += -0.038 * math.cos(DEG_TO_RAD * 6 * P) * DEG_TO_RAD * 6 * dP_dt + 0.031 * (-math.sin(DEG_TO_RAD * 6 * P)) * DEG_TO_RAD * 6 * dP_dt
    dlon_dt_deg += 0.020 * math.cos(DEG_TO_RAD * sp) * DEG_TO_RAD * dsp_dt + (-0.010) * (-math.sin(DEG_TO_RAD * sp)) * DEG_TO_RAD * dsp_dt
    float dlon_dt = dlon_dt_deg * DEG_TO_RAD

    float dlat_dt_deg = 0.0
    dlat_dt_deg += -5.453 * math.cos(DEG_TO_RAD * P) * DEG_TO_RAD * dP_dt + (-14.975) * (-math.sin(DEG_TO_RAD * P)) * DEG_TO_RAD * dP_dt
    dlat_dt_deg += 3.527 * math.cos(DEG_TO_RAD * 2 * P) * DEG_TO_RAD * 2 * dP_dt + 1.673 * (-math.sin(DEG_TO_RAD * 2 * P)) * DEG_TO_RAD * 2 * dP_dt
    dlat_dt_deg += -1.051 * math.cos(DEG_TO_RAD * 3 * P) * DEG_TO_RAD * 3 * dP_dt + 0.328 * (-math.sin(DEG_TO_RAD * 3 * P)) * DEG_TO_RAD * 3 * dP_dt
    dlat_dt_deg += 0.179 * math.cos(DEG_TO_RAD * 4 * P) * DEG_TO_RAD * 4 * dP_dt + (-0.292) * (-math.sin(DEG_TO_RAD * 4 * P)) * DEG_TO_RAD * 4 * dP_dt
    dlat_dt_deg += 0.019 * math.cos(DEG_TO_RAD * 5 * P) * DEG_TO_RAD * 5 * dP_dt + 0.100 * (-math.sin(DEG_TO_RAD * 5 * P)) * DEG_TO_RAD * 5 * dP_dt
    dlat_dt_deg += -0.031 * math.cos(DEG_TO_RAD * 6 * P) * DEG_TO_RAD * 6 * dP_dt + (-0.026) * (-math.sin(DEG_TO_RAD * 6 * P)) * DEG_TO_RAD * 6 * dP_dt
    dlat_dt_deg += 0.011 * (-math.sin(DEG_TO_RAD * sp)) * DEG_TO_RAD * dsp_dt
    float dlat_dt = dlat_dt_deg * DEG_TO_RAD

    float dr_dt = 0.0
    dr_dt += 6.68 * math.cos(DEG_TO_RAD * P) * DEG_TO_RAD * dP_dt + 6.90 * (-math.sin(DEG_TO_RAD * P)) * DEG_TO_RAD * dP_dt
    dr_dt += -1.18 * math.cos(DEG_TO_RAD * 2 * P) * DEG_TO_RAD * 2 * dP_dt + (-0.03) * (-math.sin(DEG_TO_RAD * 2 * P)) * DEG_TO_RAD * 2 * dP_dt
    dr_dt += 0.15 * math.cos(DEG_TO_RAD * 3 * P) * DEG_TO_RAD * 3 * dP_dt + (-0.14) * (-math.sin(DEG_TO_RAD * 3 * P)) * DEG_TO_RAD * 3 * dP_dt

    float lon_rad = get_helio_lon(t) * DEG_TO_RAD
    float lat_rad = get_helio_lat(t) * DEG_TO_RAD
    float r = get_helio_radius(t)

    float cl = math.cos(lon_rad)
    float sl = math.sin(lon_rad)
    float cb = math.cos(lat_rad)
    float sb = math.sin(lat_rad)

    float x = r * cb * cl
    float y = r * cb * sl

    float vx = dr_dt * cb * cl - r * dlat_dt * sb * cl - r * cb * sl * dlon_dt
    float vy = dr_dt * cb * sl - r * dlat_dt * sb * sl + r * cb * cl * dlon_dt

    // Earth terms with adjusted t_mill = t /10

    float t_mill = t / 10.0

    array<core.vsop_term> L0_e = array.new<core.vsop_term>()
    array.push(L0_e, core.vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0_e, core.vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0_e, core.vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0_e, core.vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0_e, core.vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0_e, core.vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0_e, core.vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0_e, core.vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0_e, core.vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0_e, core.vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<core.vsop_term> L1_e = array.new<core.vsop_term>()
    array.push(L1_e, core.vsop_term.new(6283.07584999140, 0.0, 0.0))
    array.push(L1_e, core.vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1_e, core.vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1_e, core.vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<core.vsop_term> L2_e = array.new<core.vsop_term>()
    array.push(L2_e, core.vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2_e, core.vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    float L0sum_e = core.eval_vsop87(L0_e, t_mill)
    float L1sum_e = core.eval_vsop87(L1_e, t_mill)
    float L2sum_e = core.eval_vsop87(L2_e, t_mill)
    float lon_rad_e = L0sum_e + L1sum_e * t_mill + L2sum_e * t_mill * t_mill

    float dL0_e = core.eval_vsop87_derivative(L0_e, t_mill)
    float dL1_e = core.eval_vsop87_derivative(L1_e, t_mill)
    float dL2_e = core.eval_vsop87_derivative(L2_e, t_mill)
    float dlon_dt_mill = dL0_e + L1sum_e + t_mill * dL1_e + 2.0 * t_mill * L2sum_e + t_mill * t_mill * dL2_e
    float dlon_dt_e = dlon_dt_mill * 0.1

    array<core.vsop_term> B0_e = array.new<core.vsop_term>()
    array.push(B0_e, core.vsop_term.new(0.00000279620, 3.19870156017, 84334.66158130829))
    array.push(B0_e, core.vsop_term.new(0.00000101643, 5.42248619256, 5507.55323866740))

    array<core.vsop_term> B1_e = array.new<core.vsop_term>()
    array.push(B1_e, core.vsop_term.new(0.00000009030, 3.89729061890, 5507.55323866740))

    float B0sum_e = core.eval_vsop87(B0_e, t_mill)
    float B1sum_e = core.eval_vsop87(B1_e, t_mill)
    float lat_rad_e = B0sum_e + B1sum_e * t_mill

    float dB0_e = core.eval_vsop87_derivative(B0_e, t_mill)
    float dB1_e = core.eval_vsop87_derivative(B1_e, t_mill)
    float dlat_dt_mill = dB0_e + B1sum_e + t_mill * dB1_e
    float dlat_dt_e = dlat_dt_mill * 0.1

    array<core.vsop_term> R0_e = array.new<core.vsop_term>()
    array.push(R0_e, core.vsop_term.new(1.00000101778, 0.0, 0.0))
    array.push(R0_e, core.vsop_term.new(0.01670861753, 3.09846350771, 6283.07584999140))
    array.push(R0_e, core.vsop_term.new(0.00013956023, 3.05524609620, 12566.15169998280))
    array.push(R0_e, core.vsop_term.new(0.00003083720, 5.19846674381, 77713.77146812050))
    array.push(R0_e, core.vsop_term.new(0.00001628461, 1.17387749012, 5753.38488489680))

    array<core.vsop_term> R1_e = array.new<core.vsop_term>()
    array.push(R1_e, core.vsop_term.new(0.00005641515, 4.29697744294, 6283.07584999140))
    array.push(R1_e, core.vsop_term.new(0.00001252975, 2.69402198377, 12566.15169998280))

    array<core.vsop_term> R2_e = array.new<core.vsop_term>()
    array.push(R2_e, core.vsop_term.new(0.00004392, 0.0, 0.0))

    float R0sum_e = core.eval_vsop87(R0_e, t_mill)
    float R1sum_e = core.eval_vsop87(R1_e, t_mill)
    float R2sum_e = core.eval_vsop87(R2_e, t_mill)
    float r_e = R0sum_e + R1sum_e * t_mill + R2sum_e * t_mill * t_mill

    float dR0_e = core.eval_vsop87_derivative(R0_e, t_mill)
    float dR1_e = core.eval_vsop87_derivative(R1_e, t_mill)
    float dR2_e = core.eval_vsop87_derivative(R2_e, t_mill)
    float dr_dt_mill = dR0_e + R1sum_e + t_mill * dR1_e + 2.0 * t_mill * R2sum_e + t_mill * t_mill * dR2_e
    float dr_dt_e = dr_dt_mill * 0.1

    float cl_e = math.cos(lon_rad_e)
    float sl_e = math.sin(lon_rad_e)
    float cb_e = math.cos(lat_rad_e)
    float sb_e = math.sin(lat_rad_e)

    float x_e = r_e * cb_e * cl_e
    float y_e = r_e * cb_e * sl_e

    float vx_e = dr_dt_e * cb_e * cl_e - r_e * dlat_dt_e * sb_e * cl_e - r_e * cb_e * sl_e * dlon_dt_e
    float vy_e = dr_dt_e * cb_e * sl_e - r_e * dlat_dt_e * sb_e * sl_e + r_e * cb_e * cl_e * dlon_dt_e

    float geo_x = x - x_e
    float geo_y = y - y_e
    float v_geo_x = vx - vx_e
    float v_geo_y = vy - vy_e

    float denom = geo_x * geo_x + geo_y * geo_y
    float dlambda_dt = (geo_x * v_geo_y - geo_y * v_geo_x) / denom

    dlambda_dt * RAD_TO_DEG / 36525.0

