var float PI = 3.141592653589793
var float RAD_TO_DEG = 180.0 / PI


// ─────────────────────── VSOP Term Type ───────────────────────
// A single VSOP term: amplitude * cos(phase + frequency * t)
export type vsop_term
    float amp     // amplitude of the cosine term
    float phase   // phase offset in radians
    float freq    // frequency multiplier of t


// ─────────────────────── Evaluators ───────────────────────

// /**
//  * Evaluates a VSOP87 sum for a given array of vsop_terms
//  * @param terms terms - Array of vsop_term
//  * @param t - Julian centuries since J2000.0
//  * @return float - evaluated VSOP sum (in radians or AU)
//  */
export eval_vsop87(array<vsop_term> terms, float t) =>
    sum = 0.0
    for i = 0 to array.size(terms) - 1
        t_i = array.get(terms, i)
        sum += t_i.amp * math.cos(t_i.phase + t_i.freq * t)
    sum

// /**
//  * Evaluates the time derivative of a VSOP87 sum (for velocity/speed)
//  * @param terms - Array of vsop_term
//  * @param t - Julian centuries since J2000.0
//  * @return float - time derivative of the VSOP sum
//  */
export eval_vsop87_derivative(array<vsop_term> terms, float t) =>
    sum = 0.0
    for i = 0 to array.size(terms) - 1
        vsop_term term = array.get(terms, i)
        sum += -term.amp * term.freq * math.sin(term.phase + term.freq * t)
    sum


