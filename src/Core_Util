    array.push(L1, vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<vsop_term> L2 = array.new<vsop_term>()
    array.push(L2, vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2, vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    L0sum = eval_vsop87(L0, t)
    L1sum = eval_vsop87(L1, t)
    L2sum = eval_vsop87(L2, t)

    dL0 = eval_vsop87_derivative(L0, t)
    dL1 = eval_vsop87_derivative(L1, t)
    dL2 = eval_vsop87_derivative(L2, t)

    float dlon_rad_dt = dL0 + L1sum + t * dL1 + 2.0 * t * L2sum + t * t * dL2
    (dlon_rad_dt * RAD_TO_DEG / 36525.0) / 10 // Convert to deg/day (since t in centuries, 36525 days/century)

// Geocentric equatorial declination of the Sun (in degrees)
export get_sun_decl(float t) =>
    float sun_ecl_lon_deg = get_sun_geo_lon(t)
    float sun_ecl_lat_deg = 0.0  // Sun ecliptic latitude is approximately 0
    float ecl_lon_rad = sun_ecl_lon_deg * (PI / 180.0)
    float ecl_lat_rad = sun_ecl_lat_deg * (PI / 180.0)
    float eps = get_obliquity(t)
    float eps_rad = eps * (PI / 180.0)
    float sin_delta = math.sin(ecl_lat_rad) * math.cos(eps_rad) + math.cos(ecl_lat_rad) * math.sin(eps_rad) * math.sin(ecl_lon_rad)
    math.asin(sin_delta) * (180.0 / PI)

