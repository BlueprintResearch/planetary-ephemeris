// need to pull these into other libs - for moon and pluto
export get_julian_millennia(float time_) =>
    jd = time_ / 86400000.0 + 2440587.5
    (jd - 2451545.0) / 365250.0


// Use for the rest of the planets not moon or pluto 
export get_julian_centuries(float time_) =>
    jd = time_ / 86400000.0 + 2440587.5
    (jd - 2451545.0) / 36525.0



