// @function Get bar interval in milliseconds for current timeframe
// @returns (int) Time interval between bars in milliseconds
export get_bar_gap_ms() =>
    int(timeframe.in_seconds(timeframe.period) * 1000)

// @function Calculate future timestamp for projection plotting
// @param current_time (int) Current bar time in milliseconds (use built-in 'time')
// @param bars_ahead (int) Number of bars to project into future
// @returns (int) Future timestamp suitable for xloc.bar_time and chart.point.from_time
export get_future_time(int current_time, int bars_ahead) =>
    current_time + (get_bar_gap_ms() * bars_ahead)

// @function Check if current bar is suitable for drawing future projections
// @returns (bool) True on last bar when projections should be drawn
export is_projection_bar() =>
    (barstate.islast or barstate.isrealtime) and not barstate.isconfirmed



