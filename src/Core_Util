// /**
//  * Wraps any angle to [0, 360) degrees
//  * @param x - Angle in degrees
//  * @return float - Normalized angle
//  */
export mod360(float x) => x - 360.0 * math.floor(x / 360.0)

// /**
//  * Custom atan2 implementation to handle full 360° domain
//  * @param y - y-coordinate
//  * @param x - x-coordinate
//  * @return float - angle in radians
//  */
export custom_atan2(float y, float x) =>
    x > 0.0 ? math.atan(y / x) :
     x < 0.0 and y >= 0.0 ? math.atan(y / x) + PI :
     x < 0.0 and y < 0.0 ? math.atan(y / x) - PI :
     x == 0.0 and y > 0.0 ? PI / 2.0 :
     x == 0.0 and y < 0.0 ? -PI / 2.0 :
     0.0


