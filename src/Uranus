// @function Computes Uranus's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
export get_helio_lon(float t) =>
    array<core.vsop_term> L0 = array.new<core.vsop_term>()
    array.push(L0, core.vsop_term.new(5.48129294297, 0.0, 0.0))
    array.push(L0, core.vsop_term.new(0.09260408234, 0.89106421530, 74.78159856730))
    array.push(L0, core.vsop_term.new(0.01504247826, 3.62719262195, 1.48447270830))
    array.push(L0, core.vsop_term.new(0.00365981718, 1.89962189068, 73.29712585900))
    array.push(L0, core.vsop_term.new(0.00272328132, 3.35823706307, 149.56319713460))
    array.push(L0, core.vsop_term.new(0.00070328499, 5.39254450063, 63.73589830340))
    array.push(L0, core.vsop_term.new(0.00068892678, 6.09292489045, 76.26607127560))
    array.push(L0, core.vsop_term.new(0.00061998615, 2.26952040469, 2.96894541660))
    array.push(L0, core.vsop_term.new(0.00061950719, 2.85098872691, 11.04570026390))
    array.push(L0, core.vsop_term.new(0.00026468869, 3.14152087888, 71.81265315070))

    array<core.vsop_term> L1 = array.new<core.vsop_term>()
    array.push(L1, core.vsop_term.new(75.02543121646, 0.0, 0.0))
    array.push(L1, core.vsop_term.new(0.00154332863, 5.24158770553, 74.78159856730))
    array.push(L1, core.vsop_term.new(0.00024456413, 1.71255705309, 1.48447270830))
    array.push(L1, core.vsop_term.new(0.00009257828, 0.42844639064, 11.04570026390))
    array.push(L1, core.vsop_term.new(0.00008265977, 1.50220035110, 63.73589830340))

    array<core.vsop_term> L2 = array.new<core.vsop_term>()
    array.push(L2, core.vsop_term.new(0.00053033277, 0.0, 0.0))
    array.push(L2, core.vsop_term.new(0.00002357636, 2.26014661705, 74.78159856730))
    array.push(L2, core.vsop_term.new(0.00000769129, 4.52561041823, 11.04570026390))

    L0sum = core.eval_vsop87(L0, t)
    L1sum = core.eval_vsop87(L1, t)
    L2sum = core.eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    core.mod360(lon_rad * RAD_TO_DEG)


// @function Computes Uranus's heliocentric ecliptic latitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic latitude in radians, range approximately [-0.018, +0.018]. Note: Returns radians, not degrees.
export get_helio_lat(float t) =>
    array<core.vsop_term> B0 = array.new<core.vsop_term>()
    array.push(B0, core.vsop_term.new(0.01346277639, 2.61877810547, 74.78159856730))
    array.push(B0, core.vsop_term.new(0.00062341405, 5.08111175856, 149.56319713460))
    array.push(B0, core.vsop_term.new(0.00061601196, 3.14159265359, 0.0))
    array.push(B0, core.vsop_term.new(0.00009963744, 1.61603876357, 76.26607127560))
    array.push(B0, core.vsop_term.new(0.00009926160, 0.57630387917, 73.29712585900))
    core.eval_vsop87(B0, t)  // returns radians directly


// @function Computes Uranus's heliocentric radius (distance from Sun) using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric radius in astronomical units (AU). Typical range is 18.28-20.09 AU.
