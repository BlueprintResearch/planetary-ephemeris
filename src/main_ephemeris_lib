// Planet enumeration
export enum Planet
    Sun
    Moon
    Mercury
    Venus
    Earth
    Mars
    Jupiter
    Saturn
    Uranus
    Neptune
    Pluto



// @function Normalizes any longitude value to the range [0, 360) degrees.
// @param lon (float) Longitude in degrees (can be any value, including negative or >360).
// @returns (float) Normalized longitude in range [0, 360).
export normalizeLongitude(float lon) =>
    float norm = lon % 360
    norm += norm < 0 ? 360 : 0
    norm




