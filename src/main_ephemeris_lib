// ──────────────── RETROGRADE MOTION STATE ────────────────


// @function Returns true if the planet is currently in retrograde motion (geocentric speed < 0) == 0 = stationary.
// @param p The planet to check.
// @param t Time in Unix timestamp (milliseconds).
// @returns true if the planet is in retrograde, false otherwise.
export is_retrograde(Planet p, float t) =>
    get_speed(p, t) < 0.0





