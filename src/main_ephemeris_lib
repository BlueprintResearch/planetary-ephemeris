// @function Converts a planet string identifier to Planet enum value.
// @param planetStr (string) Planet name (case-insensitive). Supports formats: "Sun", "☉︎ Sun", "sun", "SUN"
// @returns (Planet) Corresponding Planet enum. Returns Planet.Sun if string not recognized.
// @note Supported planet strings: Sun, Moon, Mercury, Venus, Earth, Mars, Jupiter, Saturn, Uranus, Neptune, Pluto
export string_to_planet(string planetStr) =>
     str.contains(str.lower(str.trim(planetStr)), "mercury") ? Planet.Mercury :
     str.contains(str.lower(str.trim(planetStr)), "venus")   ? Planet.Venus   :
     str.contains(str.lower(str.trim(planetStr)), "earth")   ? Planet.Earth   :
     str.contains(str.lower(str.trim(planetStr)), "mars")    ? Planet.Mars    :
     str.contains(str.lower(str.trim(planetStr)), "jupiter") ? Planet.Jupiter :
     str.contains(str.lower(str.trim(planetStr)), "saturn")  ? Planet.Saturn  :
     str.contains(str.lower(str.trim(planetStr)), "uranus")  ? Planet.Uranus  :
     str.contains(str.lower(str.trim(planetStr)), "neptune") ? Planet.Neptune :
     str.contains(str.lower(str.trim(planetStr)), "pluto")   ? Planet.Pluto   :
     str.contains(str.lower(str.trim(planetStr)), "moon")    ? Planet.Moon    :
     str.contains(str.lower(str.trim(planetStr)), "sun")     ? Planet.Sun     :
     Planet.Sun

// @function Returns planetary longitude with automatic coordinate system selection.
// @param p (Planet) Planet to query.
// @param t (float) Unix timestamp in milliseconds (use built-in 'time' variable).
// @param preferGeo (bool) If true, return geocentric; if false, return heliocentric.
// @returns (float) Longitude in degrees, normalized to range [0, 360).
// @note Sun and Moon always return geocentric regardless of preference (heliocentric not applicable).
export get_longitude(Planet p, float t, bool preferGeo) =>
    if (p == Planet.Sun or p == Planet.Moon or preferGeo)
        switch p
            Planet.Sun     => core.get_sun_geo_lon(core.get_julian_millennia(t))
            Planet.Moon    => moon.get_geo_ecl_lon(core.get_julian_centuries(t))
            Planet.Mercury => mercury.get_geo_lon(core.get_julian_millennia(t))
            Planet.Venus   => venus.get_geo_lon(core.get_julian_millennia(t))
            Planet.Mars    => mars.get_geo_lon(core.get_julian_millennia(t))
            Planet.Jupiter => jupiter.get_geo_lon(core.get_julian_millennia(t))
            Planet.Saturn  => saturn.get_geo_lon(core.get_julian_millennia(t))
            Planet.Uranus  => uranus.get_geo_lon(core.get_julian_millennia(t))
            Planet.Neptune => neptune.get_geo_lon(core.get_julian_millennia(t))
            Planet.Pluto   => pluto.get_geo_lon(core.get_julian_centuries(t))
    else
        switch p
            Planet.Sun     => core.get_sun_geo_lon(core.get_julian_millennia(t))  // Sun always geo
            Planet.Mercury => mercury.get_helio_lon(core.get_julian_millennia(t))
            Planet.Venus   => venus.get_helio_lon(core.get_julian_millennia(t))
            Planet.Earth   => core.get_earth_helio_lon(core.get_julian_millennia(t))
            Planet.Mars    => mars.get_helio_lon(core.get_julian_millennia(t))
            Planet.Jupiter => jupiter.get_helio_lon(core.get_julian_millennia(t))
            Planet.Saturn  => saturn.get_helio_lon(core.get_julian_millennia(t))
            Planet.Uranus  => uranus.get_helio_lon(core.get_julian_millennia(t))
            Planet.Neptune => neptune.get_helio_lon(core.get_julian_millennia(t))
            Planet.Pluto   => pluto.get_helio_lon(core.get_julian_centuries(t))

// @function Returns planetary geocentric equatorial declination.
// @param p (Planet) Planet to query.
// @param t (float) Unix timestamp in milliseconds (use built-in 'time' variable).
// @returns (float) Geocentric declination in degrees, range [-90, +90] where positive is north.
// @note Declination is always geocentric (no heliocentric equivalent in library).
export get_declination(Planet p, float t) =>
    switch p
        Planet.Sun     => core.get_sun_decl(core.get_julian_millennia(t))
        Planet.Moon    => moon.get_declination(core.get_julian_centuries(t))
        Planet.Mercury => mercury.get_geo_decl(core.get_julian_millennia(t))
        Planet.Venus   => venus.get_geo_decl(core.get_julian_millennia(t))
        Planet.Mars    => mars.get_geo_decl(core.get_julian_millennia(t))
        Planet.Jupiter => jupiter.get_geo_decl(core.get_julian_millennia(t))
        Planet.Saturn  => saturn.get_geo_decl(core.get_julian_millennia(t))
        Planet.Uranus  => uranus.get_geo_decl(core.get_julian_millennia(t))
        Planet.Neptune => neptune.get_geo_decl(core.get_julian_millennia(t))
        Planet.Pluto   => pluto.get_geo_decl(core.get_julian_centuries(t))

// @function Returns planetary geocentric longitude speed (rate of change).
// @param p (Planet) Planet to query.
// @param t (float) Unix timestamp in milliseconds (use built-in 'time' variable).
// @returns (float) Geocentric longitude speed in degrees per day. Negative values indicate retrograde motion. Returns na for Moon.
// @note Speed is always geocentric (no heliocentric equivalent in library). Moon speed calculation not implemented.
export get_speed(Planet p, float t) =>
    switch p
        Planet.Sun     => core.get_sun_geo_speed(t)
        Planet.Moon    => na  // Moon geocentric speed calculation not implemented
        Planet.Mercury => mercury.get_geo_speed(core.get_julian_millennia(t))
        Planet.Venus   => venus.get_geo_speed(core.get_julian_millennia(t))
        Planet.Mars    => mars.get_geo_speed(core.get_julian_millennia(t))
        Planet.Jupiter => jupiter.get_geo_speed(core.get_julian_millennia(t))
        Planet.Saturn  => saturn.get_geo_speed(core.get_julian_millennia(t))
        Planet.Uranus  => uranus.get_geo_speed(core.get_julian_millennia(t))
        Planet.Neptune => neptune.get_geo_speed(core.get_julian_millennia(t))
        Planet.Pluto   => pluto.get_geo_speed(core.get_julian_centuries(t))



// ──────────────── Averages: Planetary Longitude (Geo & Helio) ────────────────


// @function get_avg6_geo_lon
// @description Returns the arithmetic average of the geocentric longitudes for the six outer planets: Mars, Jupiter, Saturn, Uranus, Neptune, and Pluto.
// @param t (float) Time in Unix timestamp (milliseconds).
// @returns (float) Average geocentric longitude of the six outer planets in degrees, range [0, 360).
export get_avg6_geo_lon(float t) =>
    array<float> longs = array.from(
         mars.get_geo_lon(core.get_julian_millennia(t)),
         jupiter.get_geo_lon(core.get_julian_millennia(t)),
         saturn.get_geo_lon(core.get_julian_millennia(t)),
         uranus.get_geo_lon(core.get_julian_millennia(t)),
         neptune.get_geo_lon(core.get_julian_millennia(t)),
         pluto.get_geo_lon(core.get_julian_centuries(t))
     )
    array.avg(longs)


