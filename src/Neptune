// @function Computes Neptune's geocentric longitude speed (rate of change over time).
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Geocentric longitude speed in degrees per day. Negative values indicate retrograde motion (apparent backward movement).
export get_geo_speed(float t) =>
    // Neptune terms and sums
    array<core.vsop_term> L0_s = array.new<core.vsop_term>()
    array.push(L0_s, core.vsop_term.new(5.31188633046, 0.0, 0.0))
    array.push(L0_s, core.vsop_term.new(0.01798475530, 2.90101273050, 38.13303563780))
    array.push(L0_s, core.vsop_term.new(0.01019727652, 0.48580923660, 1.48447270830))
    array.push(L0_s, core.vsop_term.new(0.00124531845, 4.83008090676, 36.64856292950))

    array<core.vsop_term> L1_s = array.new<core.vsop_term>()
    array.push(L1_s, core.vsop_term.new(38.13303563957, 0.0, 0.0))
    array.push(L1_s, core.vsop_term.new(0.00016604172, 4.86323329249, 1.48447270830))

    array<core.vsop_term> L2_s = array.new<core.vsop_term>()
    array.push(L2_s, core.vsop_term.new(0.00000286136, 1.18985661922, 38.13303563780))

    float L0sum_s = core.eval_vsop87(L0_s, t)
    float L1sum_s = core.eval_vsop87(L1_s, t)
    float L2sum_s = core.eval_vsop87(L2_s, t)
    float lon_rad_s = L0sum_s + L1sum_s * t + L2sum_s * t * t

    float dL0_s = core.eval_vsop87_derivative(L0_s, t)
    float dL1_s = core.eval_vsop87_derivative(L1_s, t)
    float dL2_s = core.eval_vsop87_derivative(L2_s, t)
    float dlon_dt_s = dL0_s + L1sum_s + t * dL1_s + 2.0 * t * L2sum_s + t * t * dL2_s

    array<core.vsop_term> B0_s = array.new<core.vsop_term>()
    array.push(B0_s, core.vsop_term.new(0.03088622933, 1.44104372626, 38.13303563780))

    float lat_rad_s = core.eval_vsop87(B0_s, t)
    float dlat_dt_s = core.eval_vsop87_derivative(B0_s, t)

    array<core.vsop_term> R0_s = array.new<core.vsop_term>()
    array.push(R0_s, core.vsop_term.new(30.07013206102, 0.0, 0.0))
    array.push(R0_s, core.vsop_term.new(0.27062259490, 1.32999458930, 38.13303563780))

    array<core.vsop_term> R1_s = array.new<core.vsop_term>()
    array.push(R1_s, core.vsop_term.new(0.00236338618, 0.70497954792, 38.13303563780))

    float R0sum_s = core.eval_vsop87(R0_s, t)
    float R1sum_s = core.eval_vsop87(R1_s, t)
    float r_s = R0sum_s + R1sum_s * t

    float dR0_s = core.eval_vsop87_derivative(R0_s, t)
    float dR1_s = core.eval_vsop87_derivative(R1_s, t)
    float dr_dt_s = dR0_s + R1sum_s + t * dR1_s

    float cl_s = math.cos(lon_rad_s)
    float sl_s = math.sin(lon_rad_s)
    float cb_s = math.cos(lat_rad_s)
    float sb_s = math.sin(lat_rad_s)

    float x_s = r_s * cb_s * cl_s
    float y_s = r_s * cb_s * sl_s

    float vx_s = dr_dt_s * cb_s * cl_s - r_s * dlat_dt_s * sb_s * cl_s - r_s * cb_s * sl_s * dlon_dt_s
    float vy_s = dr_dt_s * cb_s * sl_s - r_s * dlat_dt_s * sb_s * sl_s + r_s * cb_s * cl_s * dlon_dt_s

    
    // Earth terms and sums (from get_earth_helio_coords)
    array<core.vsop_term> L0_e = array.new<core.vsop_term>()
    array.push(L0_e, core.vsop_term.new(1.75347045673, 0.0, 0.0))
    array.push(L0_e, core.vsop_term.new(0.03341656456, 4.66925680417, 6283.07584999140))
    array.push(L0_e, core.vsop_term.new(0.00034894275, 4.62610241759, 12566.15169998280))
    array.push(L0_e, core.vsop_term.new(0.00003417571, 2.82886579606, 3.52311834900))
    array.push(L0_e, core.vsop_term.new(0.00003497056, 2.74411800971, 5753.38488489680))
    array.push(L0_e, core.vsop_term.new(0.00003135896, 3.62767041756, 77713.77146812050))
    array.push(L0_e, core.vsop_term.new(0.00002676218, 4.41808345438, 7860.41939243920))
    array.push(L0_e, core.vsop_term.new(0.00002342687, 6.13516214446, 3930.20969621960))
    array.push(L0_e, core.vsop_term.new(0.00001273166, 2.03709657878, 529.69096509460))
    array.push(L0_e, core.vsop_term.new(0.00001324294, 0.74246341673, 11506.76976979360))

    array<core.vsop_term> L1_e = array.new<core.vsop_term>()
    array.push(L1_e, core.vsop_term.new(6283.07584999140, 0.0, 0.0))
    array.push(L1_e, core.vsop_term.new(0.00206058863, 2.67823455584, 6283.07584999140))
    array.push(L1_e, core.vsop_term.new(0.00004303419, 2.63512233481, 12566.15169998280))
    array.push(L1_e, core.vsop_term.new(0.00000425264, 1.59046980729, 3.52311834900))

    array<core.vsop_term> L2_e = array.new<core.vsop_term>()
    array.push(L2_e, core.vsop_term.new(0.00008721859, 1.07253635559, 6283.07584999140))
    array.push(L2_e, core.vsop_term.new(0.00000990990, 3.14159265359, 0.0))

    float L0sum_e = core.eval_vsop87(L0_e, t)
    float L1sum_e = core.eval_vsop87(L1_e, t)
    float L2sum_e = core.eval_vsop87(L2_e, t)
    float lon_rad_e = L0sum_e + L1sum_e * t + L2sum_e * t * t

    float dL0_e = core.eval_vsop87_derivative(L0_e, t)
    float dL1_e = core.eval_vsop87_derivative(L1_e, t)
    float dL2_e = core.eval_vsop87_derivative(L2_e, t)
    float dlon_dt_e = dL0_e + L1sum_e + t * dL1_e + 2.0 * t * L2sum_e + t * t * dL2_e

    array<core.vsop_term> B0_e = array.new<core.vsop_term>()
    array.push(B0_e, core.vsop_term.new(0.00000279620, 3.19870156017, 84334.66158130829))
    array.push(B0_e, core.vsop_term.new(0.00000101643, 5.42248619256, 5507.55323866740))

    array<core.vsop_term> B1_e = array.new<core.vsop_term>()
    array.push(B1_e, core.vsop_term.new(0.00000009030, 3.89729061890, 5507.55323866740))

    float B0sum_e = core.eval_vsop87(B0_e, t)
    float B1sum_e = core.eval_vsop87(B1_e, t)
    float lat_rad_e = B0sum_e + B1sum_e * t

    float dB0_e = core.eval_vsop87_derivative(B0_e, t)
    float dB1_e = core.eval_vsop87_derivative(B1_e, t)
    float dlat_dt_e = dB0_e + B1sum_e + t * dB1_e

    array<core.vsop_term> R0_e = array.new<core.vsop_term>()
    array.push(R0_e, core.vsop_term.new(1.00000101778, 0.0, 0.0))
    array.push(R0_e, core.vsop_term.new(0.01670861753, 3.09846350771, 6283.07584999140))
    array.push(R0_e, core.vsop_term.new(0.00013956023, 3.05524609620, 12566.15169998280))
    array.push(R0_e, core.vsop_term.new(0.00003083720, 5.19846674381, 77713.77146812050))
    array.push(R0_e, core.vsop_term.new(0.00001628461, 1.17387749012, 5753.38488489680))

    array<core.vsop_term> R1_e = array.new<core.vsop_term>()
    array.push(R1_e, core.vsop_term.new(0.00005641515, 4.29697744294, 6283.07584999140))
    array.push(R1_e, core.vsop_term.new(0.00001252975, 2.69402198377, 12566.15169998280))

    array<core.vsop_term> R2_e = array.new<core.vsop_term>()
    array.push(R2_e, core.vsop_term.new(0.00004392, 0.0, 0.0))

    float R0sum_e = core.eval_vsop87(R0_e, t)
    float R1sum_e = core.eval_vsop87(R1_e, t)
    float R2sum_e = core.eval_vsop87(R2_e, t)
    float r_e = R0sum_e + R1sum_e * t + R2sum_e * t * t

    float dR0_e = core.eval_vsop87_derivative(R0_e, t)
    float dR1_e = core.eval_vsop87_derivative(R1_e, t)
    float dR2_e = core.eval_vsop87_derivative(R2_e, t)
    float dr_dt_e = dR0_e + R1sum_e + t * dR1_e + 2.0 * t * R2sum_e + t * t * dR2_e

    float cl_e = math.cos(lon_rad_e)
    float sl_e = math.sin(lon_rad_e)
    float cb_e = math.cos(lat_rad_e)
    float sb_e = math.sin(lat_rad_e)

    float x_e = r_e * cb_e * cl_e
    float y_e = r_e * cb_e * sl_e

    float vx_e = dr_dt_e * cb_e * cl_e - r_e * dlat_dt_e * sb_e * cl_e - r_e * cb_e * sl_e * dlon_dt_e
    float vy_e = dr_dt_e * cb_e * sl_e - r_e * dlat_dt_e * sb_e * sl_e + r_e * cb_e * cl_e * dlon_dt_e


    float geo_x = x_s - x_e
    float geo_y = y_s - y_e
    float v_geo_x = vx_s - vx_e
    float v_geo_y = vy_s - vy_e

    float denom = geo_x * geo_x + geo_y * geo_y
    float dlambda_dt = (geo_x * v_geo_y - geo_y * v_geo_x) / denom

    dlambda_dt * RAD_TO_DEG / 365250.0




// ────────────────────────────── GEO ──────────────────────────────
// @function Computes Neptune's geocentric ecliptic longitude (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Geocentric ecliptic longitude in degrees, normalized to range [0, 360).
export get_geo_lon(float t) =>
    [earth_x, earth_y, earth_z] = core.get_earth_helio_coords(t)

    neptune_lon_rad = get_helio_lon(t) * PI / 180.0
    neptune_b_rad   = get_helio_lat(t)  // already in radians
    neptune_r       = get_helio_radius(t)

    neptune_x = neptune_r * math.cos(neptune_b_rad) * math.cos(neptune_lon_rad)
    neptune_y = neptune_r * math.cos(neptune_b_rad) * math.sin(neptune_lon_rad)

    geo_x = neptune_x - earth_x
    geo_y = neptune_y - earth_y

    core.mod360(core.custom_atan2(geo_y, geo_x) * RAD_TO_DEG)



// @function Computes Neptune's geocentric ecliptic latitude (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Geocentric ecliptic latitude in degrees, range approximately [-2, +2].
export get_geo_ecl_lat(float t) =>
    lon_rad = get_helio_lon(t) * PI / 180.0
    lat_rad = get_helio_lat(t)  // already in radians
    r = get_helio_radius(t)

    neptune_x = r * math.cos(lat_rad) * math.cos(lon_rad)
    neptune_y = r * math.cos(lat_rad) * math.sin(lon_rad)
    neptune_z = r * math.sin(lat_rad)

    [earth_x, earth_y, earth_z] = core.get_earth_helio_coords(t)

    geo_x = neptune_x - earth_x
    geo_y = neptune_y - earth_y
    geo_z = neptune_z - earth_z

    r_xy = math.sqrt(geo_x * geo_x + geo_y * geo_y)
    core.custom_atan2(geo_z, r_xy) * RAD_TO_DEG


// @function Computes Neptune's geocentric equatorial declination (as seen from Earth).
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Geocentric equatorial declination in degrees, range [-90, +90] where positive is north.
export get_geo_decl(float t) =>
    float ecl_lon_deg = get_geo_lon(t)
    float ecl_lat_deg = get_geo_ecl_lat(t)
    float ecl_lon_rad = ecl_lon_deg * PI / 180.0
    float ecl_lat_rad = ecl_lat_deg * PI / 180.0
    float epsilon_deg = core.get_obliquity(t)
    float epsilon_rad = epsilon_deg * PI / 180.0

    float sin_delta = math.sin(ecl_lat_rad) * math.cos(epsilon_rad) + math.cos(ecl_lat_rad) * math.sin(epsilon_rad) * math.sin(ecl_lon_rad)
    float delta_rad = math.asin(sin_delta)
    delta_rad * RAD_TO_DEG

