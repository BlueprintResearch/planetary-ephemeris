// @function Computes Neptune's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
export get_helio_lon(float t) =>
    array<core.vsop_term> L0 = array.new<core.vsop_term>()
    array.push(L0, core.vsop_term.new(5.31188633047, 0.0, 0.0))
    array.push(L0, core.vsop_term.new(0.01798475509, 2.90101273890, 38.13303563780))
    array.push(L0, core.vsop_term.new(0.01019727662, 0.48580923660, 1.48447270830))
    array.push(L0, core.vsop_term.new(0.00124531845, 4.83008090682, 36.64856292950))
    array.push(L0, core.vsop_term.new(0.00042064450, 5.41054993053, 2.96894541660))
    array.push(L0, core.vsop_term.new(0.00037714584, 6.09221834946, 35.16409022120))
    array.push(L0, core.vsop_term.new(0.00033784738, 1.24488865578, 76.26607127560))
    array.push(L0, core.vsop_term.new(0.00016482741, 7.02338996010, 491.55792945680))
    array.push(L0, core.vsop_term.new(0.00009198582, 4.93747059924, 39.61750834610))
    array.push(L0, core.vsop_term.new(0.00008994250, 0.27462171806, 175.16605980020))

    array<core.vsop_term> L1 = array.new<core.vsop_term>()
    array.push(L1, core.vsop_term.new(38.13303563957, 0.0, 0.0))
    array.push(L1, core.vsop_term.new(0.00016604172, 4.86323329249, 1.48447270830))
    array.push(L1, core.vsop_term.new(0.00015744045, 2.27887427527, 38.13303563780))
    array.push(L1, core.vsop_term.new(0.00001306261, 3.67285209620, 2.96894541660))
    array.push(L1, core.vsop_term.new(0.00000604842, 1.50483042790, 35.16409022120))

    array<core.vsop_term> L2 = array.new<core.vsop_term>()
    array.push(L2, core.vsop_term.new(0.00000286136, 1.18985661922, 38.13303563780))
    array.push(L2, core.vsop_term.new(0.00000295650, 1.85520880574, 1.48447270830))
    array.push(L2, core.vsop_term.new(0.00000102284, 0.0, 0.0))

    L0sum = core.eval_vsop87(L0, t)
    L1sum = core.eval_vsop87(L1, t)
    L2sum = core.eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    core.mod360(lon_rad * RAD_TO_DEG)


// @function Computes Neptune's heliocentric ecliptic latitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic latitude in radians, range approximately [-0.035, +0.035]. Note: Returns radians, not degrees.
export get_helio_lat(float t) =>
    array<core.vsop_term> B0 = array.new<core.vsop_term>()
    array.push(B0, core.vsop_term.new(0.03088622933, 1.44104372644, 38.13303563780))
    array.push(B0, core.vsop_term.new(0.00027780087, 5.91271882843, 76.26607127560))
    array.push(B0, core.vsop_term.new(0.00027623609, 0.0, 0.0))
    array.push(B0, core.vsop_term.new(0.00015355489, 2.52123799551, 36.64856292950))
    array.push(B0, core.vsop_term.new(0.00015448133, 3.50877079215, 39.61750834610))
