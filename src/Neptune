    array.push(R0, core.vsop_term.new(0.00807830737, 5.18592836167, 1.48447270830))
    array.push(R0, core.vsop_term.new(0.00537760510, 4.52113902845, 35.16409022120))

    array<core.vsop_term> R1 = array.new<core.vsop_term>()
    array.push(R1, core.vsop_term.new(0.00236338618, 0.70497954792, 38.13303563780))
    array.push(R1, core.vsop_term.new(0.00013220279, 3.32015499895, 1.48447270830))
    array.push(R1, core.vsop_term.new(0.00008621863, 6.21628951630, 35.16409022120))

    array<core.vsop_term> R2 = array.new<core.vsop_term>()
    array.push(R2, core.vsop_term.new(0.00004247776, 5.89911844921, 38.13303563780))
