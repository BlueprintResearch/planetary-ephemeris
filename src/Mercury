    array.push(R0, core.vsop_term.new(0.00121281764, 6.01064153805, 78263.70942472259))
    array.push(R0, core.vsop_term.new(0.00021921969, 2.77820093972, 104351.61256629678))

    array<core.vsop_term> R1 = array.new<core.vsop_term>()
    array.push(R1, core.vsop_term.new(0.00217347739, 4.65617158663, 26087.90314157420))
