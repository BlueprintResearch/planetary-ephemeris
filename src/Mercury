    float dL1_m = core.eval_vsop87_derivative(L1_m, t)
    float dL2_m = core.eval_vsop87_derivative(L2_m, t)
    float dlon_dt_m = dL0_m + L1sum_m + t * dL1_m + 2.0 * t * L2sum_m + t * t * dL2_m

