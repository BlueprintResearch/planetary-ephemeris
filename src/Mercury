// @function Computes Mercury's heliocentric ecliptic longitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic longitude in degrees, normalized to range [0, 360).
export get_helio_lon(float t) => 
    array<core.vsop_term> L0 = array.new<core.vsop_term>()
    array.push(L0, core.vsop_term.new(4.40250710144, 0.0, 0.0))
    array.push(L0, core.vsop_term.new(0.40989414977, 1.48302034195, 26087.90314157420))
    array.push(L0, core.vsop_term.new(0.05046294199, 4.47785489540, 52175.80628314840))
    array.push(L0, core.vsop_term.new(0.00855346844, 1.16520322459, 78263.70942472259))
    array.push(L0, core.vsop_term.new(0.00585979278, 4.22090402969, 104351.61256629678))
    array.push(L0, core.vsop_term.new(0.00165590362, 4.11969163181, 5661.33204915220))
    array.push(L0, core.vsop_term.new(0.00034561897, 0.77930768443, 130439.51570787099))
    array.push(L0, core.vsop_term.new(0.00007583476, 3.71348400510, 156527.41884944518))
    array.push(L0, core.vsop_term.new(0.00003559745, 1.51202675145, 1109.37855209340))
    array.push(L0, core.vsop_term.new(0.00001726011, 0.35832267096, 182615.32199101939))

    array<core.vsop_term> L1 = array.new<core.vsop_term>()
    array.push(L1, core.vsop_term.new(26088.14706222746, 0.0, 0.0))
    array.push(L1, core.vsop_term.new(0.01126007832, 6.21703970996, 26087.90314157420))
    array.push(L1, core.vsop_term.new(0.00303471395, 3.05565472363, 52175.80628314840))
    array.push(L1, core.vsop_term.new(0.00121281763, 6.01064153797, 78263.70942472259))

    array<core.vsop_term> L2 = array.new<core.vsop_term>()
    array.push(L2, core.vsop_term.new(0.00053049845, 0.0, 0.0))
    array.push(L2, core.vsop_term.new(0.00016903658, 4.69072300649, 26087.90314157420))

    L0sum = core.eval_vsop87(L0, t)
    L1sum = core.eval_vsop87(L1, t)
    L2sum = core.eval_vsop87(L2, t)
    lon_rad = L0sum + L1sum * t + L2sum * t * t
    core.mod360(lon_rad * RAD_TO_DEG)


// @function Computes Mercury's heliocentric ecliptic latitude using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric ecliptic latitude in radians, range approximately [-0.122, +0.122]. Note: Returns radians, not degrees.
export get_helio_lat(float t) =>
    array<core.vsop_term> B0 = array.new<core.vsop_term>()
    array.push(B0, core.vsop_term.new(0.11737528962, 1.98357498767, 26087.90314157420))
    array.push(B0, core.vsop_term.new(0.02388076996, 5.03738959685, 52175.80628314840))
    array.push(B0, core.vsop_term.new(0.01222839532, 3.14159265359, 0.0))
    core.eval_vsop87(B0, t) // return radians directly


// @function Computes Mercury's heliocentric radius (distance from Sun) using VSOP87 theory.
// @param t (float) Julian millennia from J2000.0 (use core.get_julian_millennia(time)).
// @returns (float) Heliocentric radius in astronomical units (AU). Typical range is 0.31-0.47 AU.
export get_helio_radius(float t) =>
    array<core.vsop_term> R0 = array.new<core.vsop_term>()
    array.push(R0, core.vsop_term.new(0.39528271652, 0.0, 0.0))
    array.push(R0, core.vsop_term.new(0.07834131818, 6.19233722599, 26087.90314157420))
